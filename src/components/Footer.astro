---
import { commerce } from "../data/commerce";
import { publicFormAction } from "../data/site";
import { siteSettings } from "../data/settings";
import PrivacyCheck from "./PrivacyCheck.astro";
import FormHoney from "./FormHoney.astro";
import { currentLocale, pageUrl, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const formAction = publicFormAction(siteSettings.shopEmail);
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div>
      <h2>Newsletter</h2>
      <form
        class="newsletter-form"
        action={formAction}
        method="POST"
      >
        <input type="hidden" name="_subject" value="Newsletter Corpoceleste" />
        <input type="hidden" name="_next" data-next-grazie="newsletter" />
        <FormHoney />
        <div class="newsletter-row">
          <label class="visually-hidden" for="nl-email">{copy.forms.email}</label>
          <input id="nl-email" type="email" name="email" autocomplete="email" required placeholder={copy.forms.email} />
          <button type="submit" disabled>{copy.footer.subscribe}</button>
        </div>
        <PrivacyCheck id="nl-privacy" newsletter />
      </form>
    </div>
    <div>
      <h3>{copy.footer.studio}</h3>
      <div class="footer-menu">
        <a href={pageUrl(locale, "corsi/")}>{copy.nav.workshops}</a>
        <a href={pageUrl(locale, "contatti/")}>{copy.nav.contact}</a>
        <a href={pageUrl(locale, "bio/")}>{copy.nav.bio}</a>
      </div>
    </div>
    <div>
      <h3>{copy.nav.shop}</h3>
      <div class="footer-menu">
        <a href={pageUrl(locale, "artisti/")}>{copy.nav.artists}</a>
        <a href={pageUrl(locale, "news/")}>{copy.nav.news}</a>
      </div>
    </div>
  </div>
  <div class="wrap footer-bar">
    <div class="footer-made">
      <p>
        <a href={pageUrl(locale, "vendita/")}>{copy.footer.terms}</a>
        {" · "}<a href={pageUrl(locale, "recesso/")}>{copy.withdrawal.entry}</a>
        {" · "}<a href={pageUrl(locale, "privacy/")}>{copy.footer.privacy}</a>
        {" · "}<a href={pageUrl(locale, "cookie/")}>{copy.footer.cookies}</a>
      </p>
      <p>{commerce.legalName} · P. IVA {commerce.vatId}</p>
    </div>
  </div>
</footer>
