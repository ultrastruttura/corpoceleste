---
import { site } from "../data/site";
import { url } from "../lib/paths";
import PrivacyCheck from "./PrivacyCheck.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div>
      <h2>Newsletter</h2>
      <form
        class="newsletter-form"
        action={`https://formsubmit.co/${site.email}`}
        method="POST"
      >
        <input type="hidden" name="_subject" value="Newsletter Corpoceleste" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" data-next-grazie />
        <div class="newsletter-row">
          <label class="visually-hidden" for="nl-email">Email</label>
          <input id="nl-email" type="email" name="email" required placeholder="Email" />
          <button type="submit">Iscriviti</button>
        </div>
        <PrivacyCheck id="nl-privacy" newsletter />
      </form>
    </div>
    <div>
      <h3>Studio</h3>
      <div class="footer-menu">
        <a href={url("corsi/")}>Corsi</a>
        <a href={url("consulenza/")}>Consulenza</a>
        <a href={url("contatti/")}>Contatti</a>
        <a href={site.corpoc} rel="noopener noreferrer">Corpoc, 2012–2019</a>
      </div>
    </div>
    <div>
      <h3>Shop</h3>
      <div class="footer-menu">
        <a href={url("artisti/")}>Artisti</a>
        <a href={url("news/")}>News</a>
      </div>
    </div>
  </div>
  <div class="wrap footer-bar">
    <nav class="footer-social" aria-label="Social">
      <a href={site.instagram} rel="noopener noreferrer" target="_blank" aria-label="Instagram">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
      <a href={site.facebook} rel="noopener noreferrer" target="_blank" aria-label="Facebook">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M14 8.2h2.7V5H14c-2.5 0-4.2 1.6-4.2 4.3v1.9H7.5V14h2.3v7h3.2v-7h2.6l.4-2.8h-3V9.5c0-.7.3-1.3 1-1.3z"></path>
        </svg>
      </a>
    </nav>
    <p class="footer-made">
      Made in Bergamo. {year} Corpoceleste
      · <a href={url("privacy/")}>Privacy</a>
    </p>
  </div>
</footer>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
