---
import { site, publicFormAction } from "../data/site";
import { siteSettings } from "../data/settings";
import PrivacyCheck from "./PrivacyCheck.astro";
import FormHoney from "./FormHoney.astro";
import { currentLocale, pageUrl, t } from "../i18n";

const year = new Date().getFullYear();
const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const formAction = publicFormAction(siteSettings.shopEmail);
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div>
      <h2>Newsletter</h2>
      <form
        class="newsletter-form"
        action={formAction}
        method="POST"
      >
        <input type="hidden" name="_subject" value="Newsletter Corpoceleste" />
        <input type="hidden" name="_next" data-next-grazie="newsletter" />
        <FormHoney />
        <div class="newsletter-row">
          <label class="visually-hidden" for="nl-email">{copy.forms.email}</label>
          <input id="nl-email" type="email" name="email" required placeholder={copy.forms.email} />
          <button type="submit">{copy.footer.subscribe}</button>
        </div>
        <PrivacyCheck id="nl-privacy" newsletter />
      </form>
    </div>
    <div>
      <h3>{copy.footer.studio}</h3>
      <div class="footer-menu">
        <a href={pageUrl(locale, "corsi/")}>{copy.nav.workshops}</a>
        <a href={pageUrl(locale, "consulenza/")}>{copy.nav.consulting}</a>
        <a href={pageUrl(locale, "contatti/")}>{copy.nav.contact}</a>
        <a href={site.corpoc} rel="noopener noreferrer">Corpoc, 2012–2019</a>
        <a href={site.ultrastruttura} rel="noopener noreferrer">Ultrastruttura</a>
      </div>
    </div>
    <div>
      <h3>{copy.nav.shop}</h3>
      <div class="footer-menu">
        <a href={pageUrl(locale, "artisti/")}>{copy.nav.artists}</a>
        <a href={pageUrl(locale, "news/")}>{copy.nav.news}</a>
      </div>
    </div>
  </div>
  <div class="wrap footer-bar">
    <nav class="footer-social" aria-label={copy.footer.social}>
      <a href={site.instagram} rel="noopener noreferrer" target="_blank" aria-label="Instagram">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
      <a href={site.facebook} rel="noopener noreferrer" target="_blank" aria-label="Facebook">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M14 8.2h2.7V5H14c-2.5 0-4.2 1.6-4.2 4.3v1.9H7.5V14h2.3v7h3.2v-7h2.6l.4-2.8h-3V9.5c0-.7.3-1.3 1-1.3z"></path>
        </svg>
      </a>
    </nav>
    <div class="footer-made">
      <p>
        {copy.footer.made} {year}
        {" · "}<a href={pageUrl(locale, "vendita/")}>{copy.footer.terms}</a>
        {" · "}<a href={pageUrl(locale, "recesso/")}>{copy.footer.withdrawal}</a>
        {" · "}<a href={pageUrl(locale, "privacy/")}>{copy.footer.privacy}</a>
        {" · "}<a href={pageUrl(locale, "cookie/")}>{copy.footer.cookies}</a>
        {" · "}<a href={pageUrl(locale, "account/")}>Area</a>
      </p>
    </div>
  </div>
</footer>
