---
/**
 * Honeypot + slot for invisible Cloudflare Turnstile (bound in shop.ts).
 * Site key: site.ts / data-turnstile. Secret: TURNSTILE_SECRET_KEY on Vercel.
 */
import { site } from "../data/site";

const turnstileKey = String(site.turnstileSiteKey || "").trim();
---

<input
  type="text"
  name="_honey"
  value=""
  tabindex="-1"
  autocomplete="off"
  class="honey"
  aria-hidden="true"
/>
{turnstileKey && <div data-turnstile-slot aria-hidden="true"></div>}

<style>
  .honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  [data-turnstile-slot] {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
