---
import { asset } from "../lib/paths";
import { site } from "../data/site";
import { currentLocale, pageUrl, t } from "../i18n";
import LangSwitch from "./LangSwitch.astro";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const path = Astro.url.pathname;

function active(href: string) {
  const full = pageUrl(locale, href);
  if (!href) return path === full ? "is-active" : "";
  return path.startsWith(full) ? "is-active" : "";
}
---

<header class="header">
  <div class="header-inner">
    <div class="brand">
      <a class="logo" href={pageUrl(locale)}>
        <img class="logo-mark" src={asset("brand/logo-stella.png")} alt={copy.nav.brandMark} width="32" height="32" decoding="async" fetchpriority="low" />
        <img class="logo-word" src={asset("brand/logo-scritta-sm.png")} alt={copy.nav.brandWord} width="180" height="14" decoding="async" fetchpriority="low" />
      </a>
    </div>
    <nav class="nav" aria-label={copy.nav.main}>
      <a class={active("")} href={pageUrl(locale)} data-nav={copy.nav.shop}><span class="nav-label">{copy.nav.shop}</span></a>
      <a class={active("artisti/")} href={pageUrl(locale, "artisti/")} data-nav={copy.nav.artists}><span class="nav-label">{copy.nav.artists}</span></a>
      <a class={active("news/")} href={pageUrl(locale, "news/")} data-nav={copy.nav.news}><span class="nav-label">{copy.nav.news}</span></a>
      <a class={active("corsi/")} href={pageUrl(locale, "corsi/")} data-nav={copy.nav.workshops}><span class="nav-label">{copy.nav.workshops}</span></a>
      <a class={active("bio/")} href={pageUrl(locale, "bio/")} data-nav={copy.nav.bio}><span class="nav-label">{copy.nav.bio}</span></a>
      <a class={active("contatti/")} href={pageUrl(locale, "contatti/")} data-nav={copy.nav.contact}><span class="nav-label">{copy.nav.contact}</span></a>
    </nav>
    <div class="header-tools">
      <LangSwitch />
      <a
        class="icon-btn"
        href={site.instagram}
        rel="noopener noreferrer"
        target="_blank"
        aria-label="Instagram"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
      <a class="icon-btn" href={pageUrl(locale, "carrello/")} aria-label={copy.nav.cart} data-open-cart data-cart-icon hidden>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M6 7h15l-1.5 9h-12z"></path>
          <path d="M6 7L5 4H2"></path>
          <circle cx="9" cy="20" r="1.2" fill="currentColor" stroke="none"></circle>
          <circle cx="18" cy="20" r="1.2" fill="currentColor" stroke="none"></circle>
        </svg>
        <span class="bag-count" data-bag-count data-count="0"></span>
      </a>
      <button
        class="icon-btn menu-toggle"
        type="button"
        aria-label={copy.nav.menu}
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-toggle
      >
        <span></span>
      </button>
    </div>
  </div>
</header>

<nav class="mobile-nav" id="site-menu" data-mobile-nav>
  <a class={active("")} href={pageUrl(locale)}>{copy.nav.shop}</a>
  <a class={active("artisti/")} href={pageUrl(locale, "artisti/")}>{copy.nav.artists}</a>
  <a class={active("news/")} href={pageUrl(locale, "news/")}>{copy.nav.news}</a>
  <a class={active("corsi/")} href={pageUrl(locale, "corsi/")}>{copy.nav.workshops}</a>
  <a class={active("bio/")} href={pageUrl(locale, "bio/")}>{copy.nav.bio}</a>
  <a class={active("contatti/")} href={pageUrl(locale, "contatti/")}>{copy.nav.contact}</a>
  <a href={site.instagram} rel="noopener noreferrer" target="_blank">Instagram</a>
  <a class={active("carrello/")} href={pageUrl(locale, "carrello/")} data-open-cart>{copy.nav.cart}</a>
  <LangSwitch />
</nav>
