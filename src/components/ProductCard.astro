---
import type { Product } from "../data/products";
import { artistName, formatPrice, isInStock, isLowStock, productImageAlt } from "../data/products";
import { siteSettings } from "../data/settings";
import { cardImageUrls } from "../lib/paths";
import { currentLocale, pageUrl, t } from "../i18n";

type Props = { product: Product; eager?: boolean };
const { product, eager = false } = Astro.props;
const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const artist = artistName(product.artistId);
const sold = !isInStock(product);
const lowStock = !sold && isLowStock(product, siteSettings.lowStockThreshold);
const preorder = product.status === "preorder" && !sold && !lowStock;
const hasTitle = artist !== product.title;
const alt = productImageAlt(product, artist, locale);
const urls = product.images[0] ? cardImageUrls(product.images[0]) : null;
---

<a
  class:list={["card", sold && "is-sold", preorder && "is-preorder", lowStock && "is-low-stock"]}
  href={pageUrl(locale, `prodotto/${product.slug}/`)}
  data-product
  data-nuovo={product.nuovo ? "1" : "0"}
  data-status={product.status}
>
  <div class="card-frame">
    {sold && <span class="badge">{copy.shop.soldBadge}</span>}
    {lowStock && <span class="badge badge--quiet">{copy.shop.lowStockBadge}</span>}
    {preorder && <span class="badge badge--quiet">{copy.shop.preorderBadge}</span>}
    {
      urls ? (
        <img
          class="print"
          src={urls.card}
          srcset={`${urls.card} 640w, ${urls.lg} 1280w`}
          alt={alt}
          width="640"
          height="640"
          sizes="(max-width: 359px) 92vw, (max-width: 1023px) 46vw, 280px"
          loading={eager ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={eager ? "high" : "low"}
        />
      ) : (
        <div class="card-frame__empty" aria-hidden="true" />
      )
    }
  </div>
  <div class="card-meta">
    {product.artistId !== "studio" && <p class="card-artist">{artist}</p>}
    {hasTitle && <h2 class="card-title">{product.title}</h2>}
    <p class="card-price">{formatPrice(product.price)}</p>
  </div>
</a>
