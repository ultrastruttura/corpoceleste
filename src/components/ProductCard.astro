---
import { Image } from "astro:assets";
import type { Product } from "../data/products";
import { artistName, formatPrice } from "../data/products";
import { printImage } from "../lib/prints";
import { currentLocale, pageUrl, t } from "../i18n";

type Props = { product: Product; eager?: boolean };
const { product, eager = false } = Astro.props;
const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const artist = artistName(product.artistId);
const sold = product.status === "soldout";
const hasTitle = artist !== product.title;
const alt = hasTitle ? `${artist}, ${product.title}` : artist;
---

<a
  class:list={["card", sold && "is-sold"]}
  href={pageUrl(locale, `prodotto/${product.slug}/`)}
  data-product
  data-nuovo={product.nuovo ? "1" : "0"}
  data-status={product.status}
>
  <div class="card-frame">
    {sold && <span class="badge">{copy.shop.soldBadge}</span>}
    <Image
      class="print"
      src={printImage(product.print)}
      alt={alt}
      widths={[400, 800, 1200]}
      sizes="(max-width: 359px) 100vw, (max-width: 1023px) 50vw, 30vw"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={eager ? "high" : undefined}
    />
  </div>
  <div class="card-meta">
    {product.artistId !== "studio" && <div class="card-artist">{artist}</div>}
    {hasTitle && <div class="card-title">{product.title}</div>}
    <div class="card-price">{formatPrice(product.price)}</div>
  </div>
</a>
