---
import { currentLocale, pageUrl, t } from "../i18n";

type Props = {
  id: string;
  newsletter?: boolean;
};
const { id, newsletter = false } = Astro.props;
const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const privacyHref = pageUrl(locale, "privacy/");
---

<label class="check">
  {
    newsletter ? (
      <input id={id} type="checkbox" name="consenso_newsletter" value="sì" required />
    ) : (
      <input id={id} type="checkbox" name="privacy" value="presa visione" required />
    )
  }
  <span>
    {newsletter ? copy.forms.newsletterLead : copy.forms.privacyLead}<a href={privacyHref}>{copy.forms.privacy}</a>{copy.forms.privacyTail}
  </span>
</label>
