---
import type { Product } from "../data/products";
import ProductCard from "./ProductCard.astro";

type Props = { products: Product[]; class?: string; eager?: number };
const { products, class: className, eager = 0 } = Astro.props;
const listed = products.filter((p) => !p.hidden);
---

<div class:list={["grid", className]} data-product-grid>
  {listed.map((p, i) => <ProductCard product={p} eager={i < eager} />)}
</div>
