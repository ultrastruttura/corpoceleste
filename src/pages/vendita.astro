---
import Base from "../layouts/Base.astro";
import { commerce } from "../data/commerce";
import { siteSettings } from "../data/settings";
import { currentLocale, pageUrl, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const v = copy.terms;
const shopEmail = siteSettings.shopEmail;
---

<Base title={`${v.title} — Corpoceleste`}>
  <div class="wrap page-main">
    <header class="page-hero">
      <h1>{v.title}</h1>
      <p class="lede">{v.lede}</p>
    </header>

    <div class="prose page-main--article">
      <p>{v.updated}</p>

      <h2>{v.seller}</h2>
      <p>
        {commerce.legalName || commerce.intestatario}<br />
        {commerce.indirizzo || commerce.sede}<br />
        {commerce.vatId ? <>{v.vatLabel} {commerce.vatId}<br /></> : <>{v.vatMissing}<br /></>}
        {commerce.rea && <>{v.reaLabel} {commerce.rea}<br /></>}
        {commerce.sdiCode && <>{v.sdiLabel} {commerce.sdiCode}<br /></>}
        {commerce.telefono && <>{commerce.telefono}<br /></>}
        {commerce.pec && (
          <>
            {v.pecLabel} <a href={`mailto:${commerce.pec}`}>{commerce.pec}</a>
            <br />
          </>
        )}
        {v.contactLabel} <a href={`mailto:${shopEmail}`}>{shopEmail}</a>
      </p>

      <h2>{v.scope}</h2>
      <p>{v.scopeBody}</p>

      <h2>{v.products}</h2>
      <p>{v.productsBody}</p>

      <h2>{v.prices}</h2>
      <p>{v.pricesBody}</p>

      <h2>{v.order}</h2>
      <p>{v.orderBody}</p>

      <h2>{v.payment}</h2>
      <p>{v.paymentBody}</p>
      {
        commerce.iban && (
          <p>
            {v.ibanLabel} <span class="iban">{commerce.iban}</span>
            <br />
            {v.ibanHolderLabel} {commerce.intestatario}
          </p>
        )
      }

      <h2>{v.shipping}</h2>
      <p>{v.shippingBody(commerce.shippingDays)}</p>

      <h2 id="recesso">{v.withdrawal}</h2>
      <p>{v.withdrawalBody}</p>
      <p>
        {v.withdrawalHow}
        {" "}
        <a href={pageUrl(locale, "recesso/")}>{v.withdrawalLink}</a>.
      </p>
      <p>{v.withdrawalEffects}</p>
      <p>{v.withdrawalExceptions}</p>

      <h2>{v.warranty}</h2>
      <p>{v.warrantyBody}</p>

      <h2>{v.complaints}</h2>
      <p>{v.complaintsBody}</p>

      <h2>{v.law}</h2>
      <p>{v.lawBody}</p>
    </div>
  </div>
</Base>
