---
import { artists } from "../../data/artists";
import { currentLocale, pageUrl } from "../../i18n";

/** Paths kept so old URLs exist as redirects; pages stay closed for launch. */
export function getStaticPaths() {
  return artists.map((a) => ({ params: { slug: a.slug } }));
}

const locale = currentLocale(Astro.currentLocale);
return Astro.redirect(pageUrl(locale, "artisti/"));
---
