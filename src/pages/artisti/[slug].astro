---
import Base from "../../layouts/Base.astro";
import ProductGrid from "../../components/ProductGrid.astro";
import { artists, artistBySlug, artistBio } from "../../data/artists";
import { productsByArtist } from "../../data/products";
import { currentLocale, pageUrl, t } from "../../i18n";

export function getStaticPaths() {
  return artists.map((a) => ({ params: { slug: a.slug } }));
}

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const artist = artistBySlug(Astro.params.slug!);
if (!artist) return Astro.redirect(pageUrl(locale, "artisti/"));
const works = productsByArtist(artist.id);
const bio = artistBio(artist, locale);
---

<Base title={`${artist.name} — Corpoceleste`} description={bio || undefined}>
  <div class="wrap">
    <header class="page-hero">
      <p class="card-artist"><a href={pageUrl(locale, "artisti/")}>{copy.artists.title}</a></p>
      <h1>{artist.name}</h1>
      {bio && <p class="lede">{bio}</p>}
    </header>
    <ProductGrid products={works} />
  </div>
</Base>
