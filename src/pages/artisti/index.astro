---
import Base from "../../layouts/Base.astro";
import { currentLocale, t } from "../../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
---

<Base title={`${copy.artists.title} — Corpoceleste`}>
  <div class="wrap page-pad">
    <header class="page-hero">
      <h1 class="visually-hidden">{copy.artists.title}</h1>
    </header>
    <p class="lede artist-directory--closed">{copy.artists.closed}</p>
  </div>
</Base>
