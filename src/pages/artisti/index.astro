---
import Base from "../../layouts/Base.astro";
import { artists, artistSortKeyFor } from "../../data/artists";
import { currentLocale, pageUrl, t } from "../../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const listed = [...artists].sort((a, b) =>
  artistSortKeyFor(a).localeCompare(artistSortKeyFor(b), locale, { sensitivity: "base" }),
);

const groups = new Map<string, typeof listed>();
for (const a of listed) {
  const letter = artistSortKeyFor(a)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .charAt(0)
    .toUpperCase();
  const key = /[A-Z]/.test(letter) ? letter : "#";
  const bucket = groups.get(key) || [];
  bucket.push(a);
  groups.set(key, bucket);
}
---

<Base title={`${copy.artists.title} — Corpoceleste`}>
  <div class="wrap page-pad">
    <header class="page-hero">
      <h1>{copy.artists.title}</h1>
    </header>
    <ul class="artist-directory name-list">
      {
        [...groups.entries()].map(([letter, items]) => (
          <>
            <li class="artist-directory__letter">
              <span class="artist-letter">{letter}</span>
            </li>
            {items.map((a) => (
              <li>
                <a href={pageUrl(locale, `artisti/${a.slug}/`)}>{a.name}</a>
              </li>
            ))}
          </>
        ))
      }
    </ul>
  </div>
</Base>
