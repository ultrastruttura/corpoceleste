---
import Base from "../../layouts/Base.astro";
import { artists } from "../../data/artists";
import { currentLocale, pageUrl, t } from "../../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const listed = [...artists].sort((a, b) => a.name.localeCompare(b.name, locale));

const groups = new Map<string, typeof listed>();
for (const a of listed) {
  const letter = a.name
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .charAt(0)
    .toUpperCase();
  const key = /[A-Z]/.test(letter) ? letter : "#";
  const bucket = groups.get(key) || [];
  bucket.push(a);
  groups.set(key, bucket);
}
---

<Base title={`${copy.artists.title} — Corpoceleste`}>
  <div class="wrap page-pad">
    <h1 class="visually-hidden">{copy.artists.title}</h1>
    {
      [...groups.entries()].map(([letter, items]) => (
        <section class="artist-block">
          <h2 class="artist-letter">{letter}</h2>
          <ul class="name-list">
            {items.map((a) => (
              <li>
                <a href={pageUrl(locale, `artisti/${a.slug}/`)}>{a.name}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
