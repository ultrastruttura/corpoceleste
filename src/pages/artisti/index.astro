---
import Base from "../../layouts/Base.astro";
import { artists } from "../../data/artists";
import { currentLocale, pageUrl, t } from "../../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const listed = [...artists].sort((a, b) => a.name.localeCompare(b.name, locale));
---

<Base title={`${copy.artists.title} — Corpoceleste`}>
  <div class="wrap">
    <header class="page-hero">
      <h1>{copy.artists.title}</h1>
    </header>
    <ul class="name-list">
      {
        listed.map((a) => (
          <li>
            <a href={pageUrl(locale, `artisti/${a.slug}/`)}>{a.name}</a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
