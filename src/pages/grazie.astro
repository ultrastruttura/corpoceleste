---
import Base from "../layouts/Base.astro";
import { currentLocale, pageUrl, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
---

<Base title={`${copy.thanks.received} — Corpoceleste`}>
  <div class="wrap page-main page-main--thanks">
    <h1 data-thanks-title>{copy.thanks.received}</h1>
    <p data-thanks-body></p>
    <div class="recap" data-thanks-recap hidden></div>
    <a class="btn" href={pageUrl(locale)}>{copy.nav.shop}</a>
  </div>

  <script>
    import { clearCart, getCart, readOrderSnapshot } from "../scripts/cart";
    import { renderRecap } from "../scripts/cart-ui";
    import { currentLocale, thanksMessage } from "../i18n/runtime";

    const locale = currentLocale(document.documentElement.lang);
    const from = new URLSearchParams(location.search).get("from") || "form";
    const msg = thanksMessage(locale, from);
    const title = document.querySelector("[data-thanks-title]");
    const body = document.querySelector("[data-thanks-body]");
    const recap = document.querySelector("[data-thanks-recap]");

    if (title) title.textContent = msg.title;
    if (body) {
      body.textContent = msg.body;
      body.hidden = !msg.body;
    }

    if (msg.order && recap) {
      const snap = readOrderSnapshot();
      const items = snap?.items ?? getCart();
      const shipping = snap?.shipping ?? 0;
      if (items.length) {
        recap.hidden = false;
        renderRecap(recap, items, shipping);
      }
      clearCart();
    }
  </script>
</Base>
