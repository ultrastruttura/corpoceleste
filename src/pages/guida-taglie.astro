---
import Base from "../layouts/Base.astro";
import { fitModels } from "../data/fit-models";
import { asset } from "../lib/paths";
import { currentLocale, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const g = copy.sizeGuide;
const p = copy.product;
const models = fitModels.filter((m) => m.rows.length > 0);
---

<Base title={`${g.title} — Corpoceleste`} description={g.lede}>
  <div class="wrap page-main">
    <header class="page-hero">
      <h1>{g.title}</h1>
      <p class="lede">{g.lede}</p>
    </header>

    <div class="prose page-main--article size-guide">
      <h2>{g.howTitle}</h2>
      <p>{g.howBody}</p>

      <figure class="size-guide__figure">
        <img
          src={asset("images/guida-taglie.svg")}
          alt={g.figureAlt}
          width="360"
          height="420"
          loading="eager"
          decoding="async"
        />
      </figure>

      <ol class="size-guide__steps">
        <li>{g.howChest}</li>
        <li>{g.howLength}</li>
        <li>{g.howSleeve}</li>
      </ol>

      <h2>{g.tipTitle}</h2>
      <p>{g.tipBody}</p>

      <h2>{g.tableTitle}</h2>
      <p>{g.tableIntro}</p>

      {
        models.map((model) => (
          <section class="size-guide__model">
            <h3>{model.name || g.modelFallback}</h3>
            <div class="size-chart size-chart--guide">
              <table>
                <thead>
                  <tr>
                    <th scope="col">{g.colSize}</th>
                    {model.rows.map((row) => (
                      <th scope="col">{row.size}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <th scope="row">{g.colChest}</th>
                    {model.rows.map((row) => (
                      <td>{row.chest}</td>
                    ))}
                  </tr>
                  <tr>
                    <th scope="row">{g.colLength}</th>
                    {model.rows.map((row) => (
                      <td>{row.length}</td>
                    ))}
                  </tr>
                  <tr>
                    <th scope="row">{g.colSleeve}</th>
                    {model.rows.map((row) => (
                      <td>{row.sleeve}</td>
                    ))}
                  </tr>
                </tbody>
              </table>
            </div>
          </section>
        ))
      }

      <p class="size-chart-note">{p.sizeChartNote}</p>
    </div>
  </div>
</Base>
