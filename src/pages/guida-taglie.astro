---
import Base from "../layouts/Base.astro";
import { fitModels, modelHasSleeve } from "../data/fit-models";
import { asset } from "../lib/paths";
import { breadcrumbJsonLd, faqPageJsonLd, metaSnippet } from "../lib/seo";
import { currentLocale, pageUrl, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const g = copy.sizeGuide;
const models = fitModels.filter((m) => m.rows.length > 0);
const faq = faqPageJsonLd([
  { question: g.faqMeasureQ, answer: g.faqMeasureA },
  { question: g.faqBetweenQ, answer: g.faqBetweenA },
  { question: g.faqUnitQ, answer: g.faqUnitA },
]);
const crumbs = breadcrumbJsonLd(Astro.site, [
  { name: "Corpoceleste", path: pageUrl(locale) },
  { name: g.title, path: pageUrl(locale, "guida-taglie/") },
]);
const jsonLd = [crumbs, ...(faq ? [faq] : [])];
---

<Base
  title={`${g.title} — Corpoceleste`}
  description={metaSnippet(g.howBody)}
  jsonLd={jsonLd}
>
  <div class="wrap page-main">
    <header class="page-hero">
      <h1>{g.title}</h1>
    </header>

    <div class="prose page-main--article size-guide">
      {
        models.map((model) => {
          const tip = model.tipKey === "stretch" ? g.tipStretch : g.tipRegular;
          const showSleeve = modelHasSleeve(model.rows);
          return (
            <section class="size-guide__model" data-fit-model={model.id}>
              <h2>{model.name || g.modelFallback}</h2>
              <p>
                <strong>{g.tipLabel}</strong> {tip}
              </p>
              <div class="size-chart size-chart--guide">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">{g.colSize}</th>
                      {model.rows.map((row) => (
                        <th scope="col">{row.size}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <th scope="row">{g.colChest}</th>
                      {model.rows.map((row) => (
                        <td>{row.chest}</td>
                      ))}
                    </tr>
                    <tr>
                      <th scope="row">{g.colLength}</th>
                      {model.rows.map((row) => (
                        <td>{row.length}</td>
                      ))}
                    </tr>
                    {showSleeve && (
                      <tr>
                        <th scope="row">{g.colSleeve}</th>
                        {model.rows.map((row) => (
                          <td>{row.sleeve || "—"}</td>
                        ))}
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </section>
          );
        })
      }

      <h2>{g.howTitle}</h2>
      <p>{g.howBody}</p>

      <figure class="size-guide__figure">
        <img
          src={asset("images/guida-taglie.png")}
          alt={g.figureAlt}
          width="508"
          height="476"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <ol class="size-guide__steps">
        <li>{g.howChest}</li>
        <li>{g.howLength}</li>
      </ol>
    </div>
  </div>
  {/* Static host: filter charts by ?model=<fitModelId> from the product page link. */}
  <script is:inline>
    (function () {
      var id = new URLSearchParams(location.search).get("model");
      if (!id) return;
      document.querySelectorAll("[data-fit-model]").forEach(function (el) {
        if (el.getAttribute("data-fit-model") !== id) el.setAttribute("hidden", "");
      });
    })();
  </script>
</Base>
