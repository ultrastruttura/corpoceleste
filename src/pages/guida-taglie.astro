---
import Base from "../layouts/Base.astro";
import { fitModels, modelHasSleeve } from "../data/fit-models";
import { breadcrumbJsonLd, faqPageJsonLd, metaSnippet } from "../lib/seo";
import { currentLocale, pageUrl, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const g = copy.sizeGuide;
const models = fitModels.filter((m) => m.rows.length > 0);
const faq = faqPageJsonLd([
  { question: g.faqMeasureQ, answer: g.faqMeasureA },
  { question: g.faqBetweenQ, answer: g.faqBetweenA },
  { question: g.faqUnitQ, answer: g.faqUnitA },
]);
const crumbs = breadcrumbJsonLd(Astro.site, [
  { name: "Corpoceleste", path: pageUrl(locale) },
  { name: g.title, path: pageUrl(locale, "guida-taglie/") },
]);
const jsonLd = [crumbs, ...(faq ? [faq] : [])];
---

<Base
  title={`${g.title} — Corpoceleste`}
  description={metaSnippet(g.lede)}
  jsonLd={jsonLd}
>
  <div class="wrap page-main">
    <header class="page-hero">
      <h1>{g.title}</h1>
      <p class="lede">{g.lede}</p>
    </header>

    <div class="prose page-main--article size-guide">
      {
        models.map((model) => {
          const tip = model.tipKey === "stretch" ? g.tipStretch : g.tipRegular;
          const showSleeve = modelHasSleeve(model.rows);
          return (
            <section class="size-guide__model">
              <h2>{model.name || g.modelFallback}</h2>
              <p>
                <strong>{g.tipLabel}</strong> {tip}
              </p>
              <div class="size-chart size-chart--guide">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">{g.colItaly}</th>
                      {model.rows.map((row) => (
                        <th scope="col">{row.it || "—"}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <th scope="row">{g.colUsa}</th>
                      {model.rows.map((row) => (
                        <td>{row.size}</td>
                      ))}
                    </tr>
                    <tr>
                      <th scope="row">{g.colFrance}</th>
                      {model.rows.map((row) => (
                        <td>{row.fr || "—"}</td>
                      ))}
                    </tr>
                    <tr>
                      <th scope="row">{g.colChest}</th>
                      {model.rows.map((row) => (
                        <td>{row.chest}</td>
                      ))}
                    </tr>
                    <tr>
                      <th scope="row">{g.colLength}</th>
                      {model.rows.map((row) => (
                        <td>{row.length}</td>
                      ))}
                    </tr>
                    {showSleeve && (
                      <tr>
                        <th scope="row">{g.colSleeve}</th>
                        {model.rows.map((row) => (
                          <td>{row.sleeve || "—"}</td>
                        ))}
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </section>
          );
        })
      }

      <h2>{g.howTitle}</h2>
      <p>{g.howBody}</p>

      <figure class="size-guide__figure">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 360 420"
          width="360"
          height="420"
          role="img"
          aria-label={g.figureAlt}
        >
          <g fill="none" stroke="#131313" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M118 78 L148 78 C155 78 160 84 160 92 L160 108 C160 122 172 132 186 132 L246 132 C260 132 272 122 272 108 L272 92 C272 84 277 78 284 78 L314 78 L342 148 L302 168 L302 352 L130 352 L130 168 L90 148 Z"></path>
            <path d="M186 132 C196 118 216 118 226 132"></path>
          </g>
          <g stroke="#131313" stroke-width="2.5" fill="#131313">
            <line x1="136" y1="178" x2="296" y2="178"></line>
            <polyline fill="none" points="148,170 136,178 148,186"></polyline>
            <polyline fill="none" points="284,170 296,178 284,186"></polyline>
            <circle cx="318" cy="178" r="14" fill="#f3f1ef" stroke="#131313" stroke-width="2.5"></circle>
            <text x="318" y="183" text-anchor="middle" font-family="Helvetica, Arial, sans-serif" font-size="16" font-weight="700" fill="#131313" stroke="none">A</text>
          </g>
          <g stroke="#131313" stroke-width="2.5" fill="#131313">
            <line x1="108" y1="132" x2="108" y2="352"></line>
            <polyline fill="none" points="100,144 108,132 116,144"></polyline>
            <polyline fill="none" points="100,340 108,352 116,340"></polyline>
            <circle cx="108" cy="372" r="14" fill="#f3f1ef" stroke="#131313" stroke-width="2.5"></circle>
            <text x="108" y="377" text-anchor="middle" font-family="Helvetica, Arial, sans-serif" font-size="16" font-weight="700" fill="#131313" stroke="none">B</text>
          </g>
        </svg>
      </figure>

      <ol class="size-guide__steps">
        <li>{g.howChest}</li>
        <li>{g.howLength}</li>
      </ol>
    </div>
  </div>
</Base>
