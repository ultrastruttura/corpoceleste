---
import Base from "../layouts/Base.astro";
import ProductGrid from "../components/ProductGrid.astro";
import { availableProducts, soldOutProducts } from "../data/products";
import { localizedSetting, siteSettings } from "../data/settings";
import { shuffle } from "../lib/shuffle";
import { cardImageUrls } from "../lib/paths";
import { metaSnippet } from "../lib/seo";
import { currentLocale, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const available = availableProducts();
const listed = [
  ...available.filter((p) => p.nuovo),
  ...shuffle(available.filter((p) => !p.nuovo)),
];
const sold = soldOutProducts();
const homeTitle = localizedSetting("homeTitle", locale) || copy.home.title;
const homeLede = (localizedSetting("homeLede", locale) || "").trim() || copy.home.lede;
const description = metaSnippet(
  localizedSetting("metaDescription", locale) || copy.meta.description,
);
const lcp = listed[0]?.images[0] ? cardImageUrls(listed[0].images[0]) : null;
---

<Base
  title={`Corpoceleste — ${homeTitle}`}
  description={description}
  image={siteSettings.ogImage}
  preloadImage={lcp?.webp}
  preloadImageType="image/webp"
>
  <div class="wrap shop-home">
    <header class="shop-home-hero">
      <h1>{homeTitle}</h1>
      {homeLede ? <p class="lede">{homeLede}</p> : null}
    </header>

    <ProductGrid products={listed} eager={1} />

    {
      sold.length > 0 && (
        <section class="shop-home-sold" aria-labelledby="shop-sold-heading">
          <h2 id="shop-sold-heading" class="shop-home-sold-title">
            {copy.shop.soldOut}
          </h2>
          <ProductGrid products={sold} />
        </section>
      )
    }
  </div>
</Base>
