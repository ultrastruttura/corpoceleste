---
import Base from "../layouts/Base.astro";
import ProductGrid from "../components/ProductGrid.astro";
import {
  availableProducts,
  productSeoDescription,
  soldOutProducts,
} from "../data/products";
import { localizedSetting, siteSettings } from "../data/settings";
import { shuffle } from "../lib/shuffle";
import { cardImageUrls } from "../lib/paths";
import { collectionPageJsonLd, metaSnippet } from "../lib/seo";
import { currentLocale, pageUrl, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const available = availableProducts();
// «Nuovo (porta in alto)»: last flagged / newest createdAt first, then shuffle the rest.
const listed = [
  ...available
    .filter((p) => p.nuovo)
    .sort((a, b) => b.createdAt.localeCompare(a.createdAt) || a.slug.localeCompare(b.slug)),
  ...shuffle(available.filter((p) => !p.nuovo)),
];
const sold = soldOutProducts();
const homeTitle =
  localizedSetting("homeTitle", locale) || copy.home.title;
const homeLede =
  localizedSetting("homeLede", locale) || copy.home.lede;
const documentTitle =
  localizedSetting("metaTitle", locale) || copy.meta.title || "Corpoceleste";
const seoDescription = metaSnippet(
  localizedSetting("metaDescription", locale) || copy.meta.description,
);
const lcp = listed[0]?.images[0] ? cardImageUrls(listed[0].images[0]).card : "";
const lcpType = /\.webp$/i.test(lcp) ? "image/webp" : "image/jpeg";

const catalogForSchema = [...listed, ...sold].filter((p) => !p.hidden);
const homePath = pageUrl(locale);
const collectionLd = collectionPageJsonLd({
  siteUrl: Astro.site,
  name: homeTitle,
  description: homeLede || seoDescription,
  path: homePath,
  products: catalogForSchema.map((p) => ({
    name: p.title,
    path: pageUrl(locale, `prodotto/${p.slug}/`),
    image: p.images[0],
    price: p.price,
    status: p.status,
    description: productSeoDescription(p, locale),
  })),
});
---

<Base
  title={documentTitle}
  description={seoDescription}
  image={siteSettings.ogImage}
  preloadImage={lcp || undefined}
  preloadImageType={lcp ? lcpType : undefined}
  jsonLd={collectionLd}
>
  <div class="wrap shop-home">
    <h1 class="visually-hidden">{homeTitle}</h1>
    {homeLede && <p class="visually-hidden">{homeLede}</p>}

    <ProductGrid products={listed} eager={1} />

    {
      sold.length > 0 && (
        <section class="shop-home-sold" aria-labelledby="shop-sold-heading">
          <h2 id="shop-sold-heading" class="shop-home-sold-title">
            {copy.shop.soldOut}
          </h2>
          <ProductGrid products={sold} />
        </section>
      )
    }
  </div>
</Base>
