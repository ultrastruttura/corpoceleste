---
import Base from "../layouts/Base.astro";
import { localizedSetting, siteSettings } from "../data/settings";
import { asset } from "../lib/paths";
import { metaSnippet } from "../lib/seo";
import { currentLocale, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const homeTitle = localizedSetting("homeTitle", locale) || copy.home.title;
const seoDescription = metaSnippet(
  localizedSetting("metaDescription", locale) || copy.meta.description,
);
const videoMp4 = asset("videos/home-stage.mp4");
const posterSrc = asset("videos/og-stage.jpg");
/* Frame from home-stage.mp4 — WhatsApp shows og:image, not the video. */
const ogImage = siteSettings.ogImage || "videos/og-stage.jpg";
---

<Base
  title="Corpoceleste"
  description={seoDescription}
  image={ogImage}
  video="videos/home-stage.mp4"
  preloadImage={posterSrc}
  preloadImageType="image/jpeg"
>
  <div class="shop-home shop-home--closed">
    <h1 class="visually-hidden">{homeTitle}</h1>
    <p class="visually-hidden">{seoDescription}</p>
    <figure class="shop-home-stage">
      {/*
        Wrapper is layout-only (zoom via box size). Never CSS mask/filter/transform on <video>
        — Safari/iOS can freeze decoded frames. src on <video> (not only <source>) for iOS autoplay.
      */}
      <div class="shop-home-stage__media">
        <video
          class="shop-home-stage__video"
          data-autoplay-video
          src={videoMp4}
          poster={posterSrc}
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          disablePictureInPicture
          preload="auto"
          aria-label={copy.home.stageAlt}
        ></video>
        <img
          class="shop-home-stage__fallback"
          src={posterSrc}
          alt={copy.home.stageAlt}
          width="1200"
          height="1200"
          decoding="async"
        />
      </div>
    </figure>
  </div>
</Base>
