---
import Base from "../layouts/Base.astro";
import { currentLocale, pageUrl, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
---

<Base title={`${copy.notFound.title} — Corpoceleste`}>
  <div class="wrap page-main page-main--404">
    <h1>404</h1>
    <p>{copy.notFound.body}</p>
    <a class="btn" href={pageUrl(locale)}>{copy.nav.shop}</a>
  </div>
</Base>
