---
import Base from "../layouts/Base.astro";
import PrivacyCheck from "../components/PrivacyCheck.astro";
import FormHoney from "../components/FormHoney.astro";
import { pastWorkshops, upcomingWorkshops } from "../data/workshops";
import { publicFormAction } from "../data/site";
import { siteSettings } from "../data/settings";
import { asset } from "../lib/paths";
import { currentLocale, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const formAction = publicFormAction(siteSettings.shopEmail);
const introParas = copy.workshops.intro.split(/\n\n+/).filter(Boolean);
---

<Base title={`${copy.workshops.title} — Corpoceleste`}>
  <div class="wrap page-pad">
    <header class="page-hero">
      <h1>{copy.workshops.title}</h1>
    </header>

    <section class="page-intro">
      <img
        class="page-intro__photo"
        src={asset("images/photos/corsi.jpg")}
        alt={copy.workshops.studioAlt}
        width="900"
        height="1125"
        loading="lazy"
        decoding="async"
      />
      <div class="page-intro__copy">
        {copy.workshops.introTitle ? <h2 class="page-intro__title">{copy.workshops.introTitle}</h2> : null}
        <div class="page-intro__body">
          {introParas.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="workshops-upcoming">
      <div class="section-head">
        <h2>{copy.workshops.upcoming}</h2>
      </div>
      {copy.workshops.upcomingLead ? (
        <p class="workshops-upcoming__lead">{copy.workshops.upcomingLead}</p>
      ) : null}
      {
        upcomingWorkshops.length > 0 ? (
          <ul class="upcoming-list">
            {upcomingWorkshops.map((w) => (
              <li class="upcoming-item">
                <div class="upcoming-item__main">
                  <p class="upcoming-item__when">{w.when}</p>
                  <p class="upcoming-item__where">{w.where}</p>
                  <p class="upcoming-item__org">
                    {copy.workshops.organizedBy}{" "}
                    <a href={w.signupUrl} rel="noopener noreferrer" target="_blank">
                      {w.organizer}
                    </a>
                  </p>
                  {w.note && <p class="upcoming-item__note">{w.note}</p>}
                </div>
                <a
                  class="btn upcoming-item__btn"
                  href={w.signupUrl}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  {copy.workshops.signup}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="upcoming-empty">{copy.workshops.upcomingEmpty}</p>
        )
      }
    </section>

    <section class="workshop-slots">
      <div class="workshop-slot">
        <h2>{copy.workshops.waitlist}</h2>
        <p>{copy.workshops.waitlistBody}</p>
        <form class="form" action={formAction} method="POST">
          <input type="hidden" name="_subject" value="Iscrizione workshop in studio" />
          <input type="hidden" name="_next" data-next-grazie="corsi" />
          <FormHoney />
          <div>
            <label for="ws-name">{copy.forms.name}</label>
            <input id="ws-name" name="nome" required />
          </div>
          <div>
            <label for="ws-email">{copy.forms.email}</label>
            <input id="ws-email" type="email" name="email" required />
          </div>
          <div>
            <label for="ws-note">{copy.forms.notes}</label>
            <textarea id="ws-note" name="note"></textarea>
          </div>
          <PrivacyCheck id="ws-privacy" />
          <button class="btn" type="submit">{copy.forms.subscribe}</button>
        </form>
      </div>
      <div class="workshop-slot">
        <h2>{copy.workshops.onSite}</h2>
        <p>{copy.workshops.onSiteBody}</p>
        <form class="form" action={formAction} method="POST">
          <input type="hidden" name="_subject" value="Proposta workshop presso di voi" />
          <input type="hidden" name="_next" data-next-grazie="workshop" />
          <FormHoney />
          <div>
            <label for="sp-name">{copy.workshops.spaceName}</label>
            <input id="sp-name" name="nome" required />
          </div>
          <div>
            <label for="sp-email">{copy.forms.email}</label>
            <input id="sp-email" type="email" name="email" required />
          </div>
          <div>
            <label for="sp-where">{copy.workshops.city}</label>
            <input id="sp-where" name="sede" required />
          </div>
          <div>
            <label for="sp-note">{copy.forms.message}</label>
            <textarea id="sp-note" name="messaggio" required></textarea>
          </div>
          <PrivacyCheck id="sp-privacy" />
          <button class="btn" type="submit">{copy.forms.send}</button>
        </form>
      </div>
    </section>

    <section class="workshops-archive">
      <div class="section-head">
        <h2>{copy.workshops.archive}</h2>
      </div>
      <p class="archive-note">{copy.workshops.since}</p>
      {
        pastWorkshops.map((block) => (
          <section class="year-block">
            <h3>{block.year}</h3>
            <ul>
              {block.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </section>
  </div>
</Base>
