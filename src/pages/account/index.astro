---
import Base from "../../layouts/Base.astro";
import { commerceApiBase as apiBase } from "../../data/commerce";
import { currentLocale, t } from "../../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const api = apiBase();
---

<Base title={`${copy.account.title} — Corpoceleste`} noIndex noAnalytics>
  <div class="wrap page-main account-page" data-account-root data-api={api}>
    <h1>{copy.account.title}</h1>
    {
      !api ? (
        <p class="lede">
          Portal non configurato: imposta <code>formApi</code> (URL Vercel) e il database Turso.
        </p>
      ) : (
        <div data-account-app>
          <p class="lede">{copy.account.loading}</p>
        </div>
      )
    }
  </div>

  {
    api && (
      <script>
        import "../../scripts/account-app.ts";
      </script>
    )
  }
</Base>
