---
import Base from "../layouts/Base.astro";
import FormHoney from "../components/FormHoney.astro";
import { commerce } from "../data/commerce";
import { siteSettings } from "../data/settings";
import { SHIP_COUNTRIES } from "../lib/ship-countries";
import { currentLocale, pageUrl, paypalSdkLocale, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const shopEmail = siteSettings.shopEmail;
const paypalClientId = commerce.paypalClientId;
const paypalSdk = Boolean(paypalClientId);
const orderAction = commerce.formApi
  ? `${commerce.formApi}/api/order`
  : `https://formsubmit.co/${shopEmail}`;
const regionNames = new Intl.DisplayNames([locale, "en"], { type: "region" });
const shipCountries = SHIP_COUNTRIES.map((code) => ({
  code,
  label: `${regionNames.of(code) || code} (${code})`,
}));
---

<Base title={`${copy.checkout.title} — Corpoceleste`}>
  <div
    class="wrap page-main page-main--narrow checkout-page"
    data-ship-need-zip={copy.checkout.shippingQuoteNeedZip}
    data-ship-loading={copy.checkout.shippingQuoteLoading}
    data-ship-error={copy.checkout.shippingQuoteError}
    data-bank-amount-due={copy.checkout.bankAmountDue}
    data-bank-amount-ship={copy.checkout.bankAmountOfWhichShip}
    data-paypal-client-id={paypalClientId || undefined}
  >
    <h1>{copy.checkout.title}</h1>

    <p class="empty" data-checkout-empty hidden>
      {copy.checkout.empty} <a href={pageUrl(locale)}>{copy.nav.shop}</a>
    </p>

    <div class="checkout-flow" data-checkout-flow hidden>
      <section class="checkout-step checkout-step--order">
        <h2 class="checkout-bank-title">{copy.checkout.shipTo}</h2>
        <div class="field checkout-ship">
          <label class="field-label" for="ship-country">{copy.checkout.shipCountry}</label>
          <select id="ship-country" data-ship-country autocomplete="country">
            {
              shipCountries.map(({ code, label }) => (
                <option value={code} selected={code === "IT"}>
                  {label}
                </option>
              ))
            }
          </select>
        </div>
        <div class="field checkout-ship">
          <label class="field-label" for="ship-zip">{copy.checkout.shipZip}</label>
          <input
            id="ship-zip"
            data-ship-zip
            type="text"
            autocomplete="postal-code"
            inputmode="text"
            spellcheck="false"
          />
        </div>
        <p class="checkout-vat" data-ship-status>{copy.checkout.shippingQuoteNeedZip}</p>
        <div class="field checkout-ship">
          <label class="field-label" for="ship-name">{copy.checkout.name}</label>
          <input id="ship-name" data-ship-name autocomplete="name" required />
        </div>
        <div class="field checkout-ship">
          <label class="field-label" for="ship-email">{copy.checkout.email}</label>
          <input id="ship-email" data-ship-email type="email" autocomplete="email" required />
        </div>
        <div class="field checkout-ship">
          <label class="field-label" for="ship-phone">{copy.checkout.phone}</label>
          <input id="ship-phone" data-ship-phone type="tel" autocomplete="tel" />
        </div>
        <div class="field checkout-ship">
          <label class="field-label" for="ship-street">{copy.checkout.address}</label>
          <input id="ship-street" data-ship-street autocomplete="street-address" required />
        </div>
        <div class="field checkout-ship">
          <label class="field-label" for="ship-city">{copy.checkout.city}</label>
          <input id="ship-city" data-ship-city autocomplete="address-level2" required />
        </div>
        <div class="field checkout-ship">
          <label class="field-label" for="ship-province">{copy.checkout.province}</label>
          <input
            id="ship-province"
            data-ship-province
            autocomplete="address-level1"
            maxlength="40"
            spellcheck="false"
            placeholder="RM"
          />
        </div>
        <div class="recap" data-recap></div>
      </section>

      <section class="checkout-step checkout-step--confirm">
        <div class="disclaimer">
          <h3>{copy.checkout.shippingTitle}</h3>
          <p>{copy.checkout.shippingBody}</p>
        </div>
        <p class="checkout-vat">{copy.checkout.vatIncluded}</p>
        <label class="check checkout-check">
          <input type="checkbox" data-disclaimer />
          <span>
            {copy.checkout.termsLead}<a href={pageUrl(locale, "vendita/")}>{copy.checkout.termsLink}</a>{copy.checkout.termsTail}
          </span>
        </label>
        <label class="check checkout-check">
          <input type="checkbox" data-privacy />
          <span>
            {copy.forms.privacyLead}<a href={pageUrl(locale, "privacy/")}>{copy.checkout.privacyLink}</a>{copy.forms.privacyTail}
          </span>
        </label>
        <p class="checkout-lock-hint" data-pay-lock-hint>{copy.checkout.unlockPay}</p>
      </section>

      <section class="checkout-step checkout-step--pay">
        <h2 class="checkout-bank-title">{copy.checkout.payTitle}</h2>

        <div class="pay-methods">
          <label class="check">
            <input
              type="radio"
              name="metodo-pagamento"
              value="paypal"
              checked={paypalSdk}
              data-method
            />
            <span>{copy.checkout.methodPaypal}</span>
          </label>
          <label class="check">
            <input
              type="radio"
              name="metodo-pagamento"
              value="bonifico"
              checked={!paypalSdk}
              data-method
            />
            <span>{copy.checkout.bank}</span>
          </label>
        </div>

        <div data-method-panel="paypal" hidden={!paypalSdk}>
          {
            paypalSdk ? (
              <>
                <p class="checkout-obligation">{copy.checkout.payObligation}</p>
                <div class="pay-box is-locked" data-pay-box>
                  <div class="pay-buttons pay-buttons--stack">
                    <div class="pay-buttons__slot">
                      <div id="paypal-button" data-paypal-slot></div>
                    </div>
                    <div class="pay-buttons__slot" data-applepay-slot>
                      <button type="button" class="wallet-btn wallet-btn--apple" data-apple-fallback>
                        {copy.checkout.applePay}
                      </button>
                      <div id="applepay-button" class="pay-buttons__sdk" hidden></div>
                    </div>
                    <div class="pay-buttons__slot" data-googlepay-slot>
                      <button type="button" class="wallet-btn wallet-btn--google" data-google-fallback>
                        {copy.checkout.googlePay}
                      </button>
                      <div id="googlepay-button" class="pay-buttons__sdk" hidden></div>
                    </div>
                  </div>
                </div>
              </>
            ) : (
              <div class="pay-box">
                <div class="pay-buttons">
                  <button class="btn btn--full" type="button" disabled>
                    {copy.checkout.paypal}
                  </button>
                  <button class="btn btn--full btn--ghost" type="button" disabled>
                    {copy.checkout.applePay}
                  </button>
                  <button class="btn btn--full btn--ghost" type="button" disabled>
                    {copy.checkout.googlePay}
                  </button>
                </div>
              </div>
            )
          }
        </div>

        <div data-method-panel="bonifico" hidden={paypalSdk}>
          <h3 class="checkout-bank-title">{copy.checkout.bank}</h3>
          <p>{copy.checkout.bankNote}</p>
          <p class="checkout-bank-due" data-bank-due hidden></p>
          <form class="form is-locked" action={orderAction} method="POST" data-checkout-form>
            <input type="hidden" name="_subject" value="Ordine shop Corpoceleste (bonifico)" />
            <input type="hidden" name="_next" data-next-grazie="ordine" />
            <input type="hidden" name="locale" value={locale} />
            <input type="hidden" name="ordine" data-order-field />
            <input type="hidden" name="lines" data-lines-field />
            <input type="hidden" name="shipCountry" data-ship-country-field value="IT" />
            <input type="hidden" name="shipZip" data-ship-zip-field value="" />
            <FormHoney />
            <input type="hidden" name="nome" data-bank-name />
            <input type="hidden" name="email" data-bank-email />
            <input type="hidden" name="telefono" data-bank-phone />
            <input type="hidden" name="indirizzo" data-bank-street />
            <input type="hidden" name="citta" data-bank-city />
            <input type="hidden" name="provincia" data-bank-province />
            <div>
              <label for="o-note">{copy.checkout.notes}</label>
              <textarea id="o-note" name="note"></textarea>
            </div>
            <input type="hidden" name="privacy" value="presa visione" />
            <button class="btn" type="submit" data-bank-submit disabled>{copy.checkout.sendOrder}</button>
          </form>
        </div>
      </section>
    </div>
  </div>

  {
    paypalSdk && (
      <script define:vars={{ clientId: paypalClientId, sdkLocale: paypalSdkLocale[locale] }}>
        const s = document.createElement("script");
        s.src = `https://www.paypal.com/sdk/js?client-id=${encodeURIComponent(clientId)}&currency=EUR&intent=capture&locale=${sdkLocale}&components=buttons,googlepay&enable-funding=applepay&disable-funding=card,credit,paylater,venmo`;
        document.head.append(s);
        const g = document.createElement("script");
        g.src = "https://pay.google.com/gp/p/js/pay.js";
        g.async = true;
        document.head.append(g);
      </script>
    )
  }

  <script>
    import { total, clearCart, saveOrderSnapshot, sanitizeCart } from "../scripts/cart";
    import { lineName, renderRecap } from "../scripts/cart-ui";
    import { normalizeZip } from "../lib/ship-normalize";
    import {
      buildShipTo,
      hasCompleteAddress as addressComplete,
      lookupCityFromZip,
      requestShippingQuote,
      type CheckoutQuote,
    } from "../scripts/checkout-ship";

    /** Browser-safe: do not import data/commerce (gray-matter → Buffer). */
    const apiBase = () =>
      (document.documentElement.dataset.api || "").replace(/\/$/, "");

    const base = import.meta.env.BASE_URL;
    const prefix = document.documentElement.dataset.localePrefix || "";
    let googlePayReady: (() => void) | null = null;
    let buttonsMounted = false;
    const page = document.querySelector<HTMLElement>(".checkout-page");
    const paypalClientId = page?.dataset.paypalClientId || "";
    const labels = {
      needZip: page?.dataset.shipNeedZip || "",
      loading: page?.dataset.shipLoading || "",
      error: page?.dataset.shipError || "",
      bankDue: page?.dataset.bankAmountDue || "",
      bankShip: page?.dataset.bankAmountShip || "",
    };
    const emptyEl = document.querySelector("[data-checkout-empty]");
    const flowEl = document.querySelector("[data-checkout-flow]");
    const recap = document.querySelector("[data-recap]");
    const countrySel = document.querySelector<HTMLSelectElement>("[data-ship-country]");
    const zipInput = document.querySelector<HTMLInputElement>("[data-ship-zip]");
    const nameInput = document.querySelector<HTMLInputElement>("[data-ship-name]");
    const emailInput = document.querySelector<HTMLInputElement>("[data-ship-email]");
    const phoneInput = document.querySelector<HTMLInputElement>("[data-ship-phone]");
    const streetInput = document.querySelector<HTMLInputElement>("[data-ship-street]");
    const cityInput = document.querySelector<HTMLInputElement>("[data-ship-city]");
    const provinceInput = document.querySelector<HTMLInputElement>("[data-ship-province]");
    const shipStatus = document.querySelector<HTMLElement>("[data-ship-status]");
    const disclaimer = document.querySelector<HTMLInputElement>("[data-disclaimer]");
    const privacy = document.querySelector<HTMLInputElement>("[data-privacy]");
    const payBox = document.querySelector("[data-pay-box]");
    const bankForm = document.querySelector<HTMLFormElement>("[data-checkout-form]");
    const bankSubmit = document.querySelector<HTMLButtonElement>("[data-bank-submit]");
    const bankDue = document.querySelector<HTMLElement>("[data-bank-due]");
    const lockHint = document.querySelector<HTMLElement>("[data-pay-lock-hint]");
    const orderField = document.querySelector<HTMLInputElement>("[data-order-field]");
    const linesField = document.querySelector<HTMLInputElement>("[data-lines-field]");
    const shipCountryField = document.querySelector<HTMLInputElement>("[data-ship-country-field]");
    const shipZipField = document.querySelector<HTMLInputElement>("[data-ship-zip-field]");
    const bankName = document.querySelector<HTMLInputElement>("[data-bank-name]");
    const bankEmail = document.querySelector<HTMLInputElement>("[data-bank-email]");
    const bankPhone = document.querySelector<HTMLInputElement>("[data-bank-phone]");
    const bankStreet = document.querySelector<HTMLInputElement>("[data-bank-street]");
    const bankCity = document.querySelector<HTMLInputElement>("[data-bank-city]");
    const bankProvince = document.querySelector<HTMLInputElement>("[data-bank-province]");
    const methods = document.querySelectorAll<HTMLInputElement>("[data-method]");
    const panels = document.querySelectorAll<HTMLElement>("[data-method-panel]");

    let quote: CheckoutQuote | null = null;
    let quoteError = false;
    let quoteLoading = false;
    let quoteSeq = 0;
    let quoteTimer: ReturnType<typeof setTimeout> | undefined;

    function destCountry() {
      return String(countrySel?.value || "IT").toUpperCase();
    }

    function destZip() {
      return normalizeZip(zipInput?.value || "", destCountry());
    }

    function syncProvinceField() {
      const it = destCountry() === "IT";
      if (!provinceInput) return;
      provinceInput.placeholder = it ? "RM" : "";
      provinceInput.maxLength = it ? 2 : 40;
      provinceInput.required = false;
      provinceInput.setAttribute("aria-required", "false");
    }

    function shipTo() {
      return buildShipTo({
        fullName: nameInput?.value || "",
        email: emailInput?.value || "",
        phone: phoneInput?.value || "",
        street: streetInput?.value || "",
        city: cityInput?.value || "",
        province: provinceInput?.value || "",
        country: destCountry(),
      });
    }

    function hasCompleteAddress() {
      return addressComplete(shipTo());
    }

    let zipLookupTimer: ReturnType<typeof setTimeout> | null = null;
    let zipLookupSeq = 0;

    async function runZipLookup() {
      const seq = ++zipLookupSeq;
      const hit = await lookupCityFromZip(destCountry(), destZip());
      if (!hit || seq !== zipLookupSeq) return;
      if (cityInput && hit.city) cityInput.value = hit.city;
      if (provinceInput && hit.province) provinceInput.value = hit.province;
      syncPage();
      scheduleQuote();
    }

    function scheduleZipLookup() {
      if (zipLookupTimer) clearTimeout(zipLookupTimer);
      zipLookupTimer = setTimeout(() => {
        void runZipLookup();
      }, 280);
    }

    function shippingAmount() {
      return quote?.shipping ?? 0;
    }

    function hasValidQuote() {
      return Boolean(quote && quote.shipping >= 0 && !quoteError && !quoteLoading);
    }

    function orderText() {
      const items = sanitizeCart();
      const ship = shippingAmount();
      const a = shipTo();
      const lines = items.map((i) => `${lineName(i)} · ${i.size} · ×${i.qty} · ${i.price * i.qty}€`);
      if (hasValidQuote()) {
        const carrier = quote?.carrier ? ` (${quote.carrier})` : "";
        lines.push(`Spedizione ${ship}€${carrier}`, `Totale ${total() + ship}€`);
      } else {
        lines.push("Spedizione: da calcolare", `Totale merce ${total()}€`);
      }
      if (hasCompleteAddress()) {
        lines.push(
          "",
          `Destinatario: ${a.fullName}`,
          a.street,
          `${[a.province, destZip(), a.city].filter(Boolean).join(" ")}`,
          destCountry(),
          ...(a.phone ? [a.phone] : []),
          a.email,
        );
      }
      return lines.join("\n");
    }

    function unlocked() {
      return Boolean(
        disclaimer?.checked &&
          privacy?.checked &&
          sanitizeCart().length &&
          hasValidQuote() &&
          hasCompleteAddress(),
      );
    }

    function syncLock() {
      const ok = unlocked();
      payBox?.classList.toggle("is-locked", !ok);
      bankForm?.classList.toggle("is-locked", !ok);
      if (bankSubmit) bankSubmit.disabled = !ok;
      if (lockHint) lockHint.hidden = ok;
    }

    function setStatus(text: string) {
      if (shipStatus) shipStatus.textContent = text;
    }

    function syncPage() {
      const items = sanitizeCart();
      const empty = !items.length;
      if (emptyEl) emptyEl.hidden = !empty;
      if (flowEl) flowEl.hidden = empty;
      if (!empty && recap) {
        renderRecap(recap, items, hasValidQuote() ? shippingAmount() : 0);
        if (orderField) orderField.value = orderText();
        if (linesField) {
          linesField.value = JSON.stringify(
            items.map((i) => ({ id: i.id, size: i.size, qty: i.qty })),
          );
        }
        if (shipCountryField) shipCountryField.value = destCountry();
        if (shipZipField) shipZipField.value = destZip();
        const a = shipTo();
        if (bankName) bankName.value = a.fullName;
        if (bankEmail) bankEmail.value = a.email;
        if (bankPhone) bankPhone.value = a.phone;
        if (bankStreet) bankStreet.value = a.street;
        if (bankCity) bankCity.value = a.city;
        if (bankProvince) bankProvince.value = a.province;
      }
      if (bankDue) {
        if (!empty && hasValidQuote()) {
          const ship = shippingAmount();
          const due = total() + ship;
          bankDue.hidden = false;
          bankDue.textContent = `${labels.bankDue}: ${due.toFixed(2)} € (${labels.bankShip} ${ship.toFixed(2)} €)`;
        } else {
          bankDue.hidden = true;
          bankDue.textContent = "";
        }
      }
      syncLock();
      page?.classList.add("is-ready");
      tryMountButtons?.();
    }

    async function fetchQuote() {
      const items = sanitizeCart();
      const country = destCountry();
      const zip = destZip();
      const createApi = apiBase();

      quote = null;
      quoteError = false;

      if (!items.length) {
        quoteLoading = false;
        setStatus(labels.needZip);
        syncPage();
        return;
      }
      if (!zip || zip.length < 3) {
        quoteLoading = false;
        setStatus(labels.needZip);
        syncPage();
        return;
      }
      if (!createApi) {
        quoteLoading = false;
        quoteError = true;
        setStatus(labels.error);
        syncPage();
        return;
      }

      const seq = ++quoteSeq;
      quoteLoading = true;
      setStatus(labels.loading);
      syncPage();

      try {
        const a = shipTo();
        const next = await requestShippingQuote({
          apiBase: createApi,
          country,
          zip,
          city: a.city || undefined,
          province: a.province || undefined,
          lines: items.map((i) => ({ id: i.id, size: i.size, qty: i.qty })),
        });
        if (seq !== quoteSeq) return;
        if (!next) {
          quoteError = true;
          quote = null;
          setStatus(labels.error);
          quoteLoading = false;
          syncPage();
          return;
        }
        quote = next;
        quoteError = false;
        quoteLoading = false;
        const carrier = quote.carrier ? ` · ${quote.carrier}` : "";
        setStatus(`${quote.shipping.toFixed(2)} €${carrier}`);
        syncPage();
      } catch (err) {
        if (seq !== quoteSeq) return;
        console.error("shipping-quote", err);
        quoteError = true;
        quote = null;
        quoteLoading = false;
        setStatus(labels.error);
        syncPage();
      } finally {
        if (seq === quoteSeq) quoteLoading = false;
        syncLock();
      }
    }

    function scheduleQuote() {
      if (quoteTimer) clearTimeout(quoteTimer);
      quoteTimer = setTimeout(() => {
        void fetchQuote();
      }, 400);
    }

    function syncMethod() {
      const chosen = [...methods].find((r) => r.checked)?.value;
      if (!chosen) return;
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.methodPanel !== chosen;
      });
      syncPage();
    }

    methods.forEach((radio) => radio.addEventListener("change", syncMethod));
    syncMethod();

    countrySel?.addEventListener("change", () => {
      syncProvinceField();
      scheduleZipLookup();
      scheduleQuote();
      syncPage();
    });
    zipInput?.addEventListener("input", () => {
      scheduleZipLookup();
      scheduleQuote();
      syncPage();
    });
    zipInput?.addEventListener("blur", () => {
      void runZipLookup();
    });
    for (const el of [nameInput, emailInput, phoneInput, streetInput, cityInput, provinceInput]) {
      el?.addEventListener("input", () => {
        syncPage();
        if (el === cityInput || el === provinceInput) scheduleQuote();
      });
    }
    disclaimer?.addEventListener("change", syncLock);
    privacy?.addEventListener("change", syncLock);
    window.addEventListener("cart:change", () => {
      scheduleQuote();
      syncPage();
    });

    bankForm?.addEventListener("submit", (e) => {
      sanitizeCart();
      syncPage();
      if (!unlocked()) {
        e.preventDefault();
        return;
      }
      saveOrderSnapshot(shippingAmount());
    });

    // Always react to Google Pay tap, even before SDK finishes loading.
    document.querySelector<HTMLButtonElement>("[data-google-fallback]")?.addEventListener(
      "click",
      (e) => {
        e.preventDefault();
        if (googlePayReady) {
          googlePayReady();
          return;
        }
        if (!unlocked()) {
          window.alert(
            lockHint?.textContent?.trim() ||
              "Accetta condizioni e privacy, completa l’indirizzo e attendi il calcolo spedizione.",
          );
          return;
        }
        window.alert("Google Pay si sta caricando… riprova tra un secondo, oppure usa PayPal.");
      },
    );

    syncProvinceField();
    syncPage();

    function mountButtons() {
      type Funding = { PAYPAL: string; APPLEPAY?: string };
      type ButtonsFactory = (o: object) => {
        render: (s: string) => Promise<void> | void;
        isEligible?: () => boolean;
      };
      type GooglePayConfig = {
        allowedPaymentMethods: unknown[];
        merchantInfo: Record<string, unknown>;
        apiVersion?: number;
        apiVersionMinor?: number;
        countryCode?: string;
        environment?: string;
      };
      type GooglePayApi = {
        config: () => Promise<GooglePayConfig>;
        confirmOrder: (o: {
          orderId: string;
          paymentMethodData: unknown;
        }) => Promise<{ status?: string }>;
        initiatePayerAction?: (o: { orderId: string }) => Promise<unknown>;
      };
      const paypal = (
        window as unknown as {
          paypal?: {
            Buttons: ButtonsFactory;
            FUNDING: Funding;
            Googlepay?: () => GooglePayApi;
          };
        }
      ).paypal;
      if (!paypal?.Buttons || !paypal.FUNDING || !sanitizeCart().length) return;

      const createApi = apiBase();
      if (!createApi) {
        console.warn("PayPal: formApi/apiBase missing — cannot create server orders");
        return;
      }

      async function createServerOrder(): Promise<string> {
        const items = sanitizeCart();
        if (!quote) throw new Error("Missing shipping quote");
        if (!hasCompleteAddress()) throw new Error("Missing shipping address");
        const a = shipTo();
        const res = await fetch(`${createApi}/api/paypal-create-order`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            lines: items.map((i) => ({ id: i.id, size: i.size, qty: i.qty })),
            country: quote.country,
            zip: quote.zip,
            shipTo: {
              fullName: a.fullName,
              email: a.email,
              phone: a.phone,
              street: a.street,
              city: a.city,
              province: a.province || quote.country,
            },
          }),
        });
        if (!res.ok) {
          const err = await res.text();
          console.error("paypal-create-order failed", res.status, err);
          throw new Error("Order create failed");
        }
        const data = (await res.json()) as { id?: string };
        if (!data.id) throw new Error("Missing order id");
        return data.id;
      }

      const shared = {
        style: { layout: "vertical", shape: "rect", height: 48 },
        onClick: (_: unknown, actions: { reject: () => Promise<void>; resolve: () => Promise<void> }) => {
          if (!unlocked()) return actions.reject();
          return actions.resolve();
        },
        createOrder: async () => createServerOrder(),
        onApprove: async (_: unknown, actions: { order: { capture: () => Promise<unknown> } }) => {
          saveOrderSnapshot(shippingAmount());
          await actions.order.capture();
          clearCart();
          location.href = `${base}${prefix}grazie/?from=paypal`;
        },
      };

      const paypalNode = document.querySelector("#paypal-button");
      if (paypalNode && !paypalNode.hasChildNodes()) {
        void paypal
          .Buttons({ ...shared, fundingSource: paypal.FUNDING.PAYPAL })
          .render("#paypal-button");
      }

      const appleFallback = document.querySelector<HTMLButtonElement>("[data-apple-fallback]");
      const appleSdk = document.querySelector<HTMLElement>("#applepay-button");
      let appleRendered = false;

      if (appleSdk && paypal.FUNDING.APPLEPAY) {
        const appleBtn = paypal.Buttons({
          ...shared,
          fundingSource: paypal.FUNDING.APPLEPAY,
          style: { ...shared.style, color: "black", label: "pay" },
        });
        const eligible = !appleBtn.isEligible || appleBtn.isEligible();
        if (eligible) {
          void appleBtn
            .render("#applepay-button")
            .then(() => {
              appleRendered = true;
              appleSdk.hidden = false;
              if (appleFallback) appleFallback.hidden = true;
            })
            .catch((err: unknown) => {
              console.warn("Apple Pay render skipped", err);
              appleSdk.hidden = true;
              if (appleFallback) appleFallback.hidden = false;
            });
        }
      }

      appleFallback?.addEventListener("click", () => {
        if (!unlocked() || appleRendered) return;
        // On Safari the SDK button replaces this; elsewhere explain availability.
        const lang = (document.documentElement.lang || "it").slice(0, 2);
        window.alert(
          lang === "en"
            ? "Apple Pay is available in Safari on Apple devices."
            : lang === "de"
              ? "Apple Pay ist in Safari auf Apple-Geräten verfügbar."
              : "Apple Pay è disponibile in Safari su dispositivi Apple.",
        );
      });

      void mountGooglePay(paypal, createApi, createServerOrder);
    }

    async function mountGooglePay(
      paypal: {
        Googlepay?: () => {
          config: () => Promise<{
            allowedPaymentMethods: unknown[];
            merchantInfo: Record<string, unknown>;
            apiVersion?: number;
            apiVersionMinor?: number;
            countryCode?: string;
            environment?: string;
          }>;
          confirmOrder: (o: {
            orderId: string;
            paymentMethodData: unknown;
          }) => Promise<{ status?: string }>;
          initiatePayerAction?: (o: { orderId: string }) => Promise<unknown>;
        };
      },
      createApi: string,
      createServerOrder: () => Promise<string>,
    ) {
      const googleFallback = document.querySelector<HTMLButtonElement>("[data-google-fallback]");
      const gpaySdk = document.querySelector<HTMLElement>("#googlepay-button");
      if (!googleFallback && !gpaySdk) return;

      type GPayClient = {
        isReadyToPay: (r: object) => Promise<{ result?: boolean }>;
        createButton: (o: object) => HTMLElement;
        loadPaymentData: (r: object) => Promise<unknown>;
      };
      type GPayCtor = new (o: Record<string, unknown>) => GPayClient;
      type GPayNS = { payments: { api: { PaymentsClient: GPayCtor } } };

      const lockMsg = () =>
        lockHint?.textContent?.trim() ||
        "Accetta condizioni e privacy, completa l’indirizzo e attendi il calcolo spedizione.";

      const waitDeps = () =>
        new Promise<{ googleNs: GPayNS; gp: NonNullable<typeof paypal.Googlepay> } | null>((resolve) => {
          let n = 0;
          const tick = () => {
            const gp = paypal.Googlepay;
            const g = (window as unknown as { google?: GPayNS }).google;
            if (gp && g?.payments?.api?.PaymentsClient) return resolve({ googleNs: g, gp });
            if (n++ > 100) return resolve(null);
            setTimeout(tick, 100);
          };
          tick();
        });

      const deps = await waitDeps();
      if (!deps) {
        console.warn("Google Pay: SDK not available");
        googlePayReady = () => window.alert("Google Pay non disponibile. Usa PayPal.");
        return;
      }

      let gpConfig: {
        allowedPaymentMethods: unknown[];
        merchantInfo: Record<string, unknown>;
        apiVersion?: number;
        apiVersionMinor?: number;
        countryCode?: string;
        environment?: string;
      };
      try {
        gpConfig = await deps.gp().config();
      } catch (err) {
        console.warn("Google Pay config unavailable", err);
        googlePayReady = () =>
          window.alert("Google Pay non è attivo sull’account PayPal. Usa PayPal.");
        return;
      }

      const allowedPaymentMethods = gpConfig.allowedPaymentMethods || [];
      if (!allowedPaymentMethods.length) {
        googlePayReady = () =>
          window.alert("Google Pay non è attivo sull’account PayPal. Usa PayPal.");
        return;
      }

      const env =
        String(gpConfig.environment || "").toUpperCase() === "TEST" ? "TEST" : "PRODUCTION";

      const startGooglePay = () => {
        if (!unlocked()) {
          window.alert(lockMsg());
          return;
        }
        const price =
          quote?.shipping != null
            ? (total() + quote.shipping).toFixed(2)
            : total().toFixed(2);
        const paymentDataRequest = {
          apiVersion: gpConfig.apiVersion ?? 2,
          apiVersionMinor: gpConfig.apiVersionMinor ?? 0,
          allowedPaymentMethods,
          merchantInfo: {
            ...gpConfig.merchantInfo,
            merchantName: String(gpConfig.merchantInfo?.merchantName || "Corpoceleste"),
          },
          transactionInfo: {
            countryCode: gpConfig.countryCode || "IT",
            currencyCode: "EUR",
            totalPriceStatus: "FINAL" as const,
            totalPrice: price,
          },
          callbackIntents: ["PAYMENT_AUTHORIZATION" as const],
        };

        const client = new deps.googleNs.payments.api.PaymentsClient({
          environment: env,
          paymentDataCallbacks: {
            onPaymentAuthorized: async (paymentData: { paymentMethodData: unknown }) => {
              try {
                const orderId = await createServerOrder();
                const gp = deps.gp();
                let confirm = await gp.confirmOrder({
                  orderId,
                  paymentMethodData: paymentData.paymentMethodData,
                });
                if (confirm.status === "PAYER_ACTION_REQUIRED" && gp.initiatePayerAction) {
                  await gp.initiatePayerAction({ orderId });
                  confirm = await gp.confirmOrder({
                    orderId,
                    paymentMethodData: paymentData.paymentMethodData,
                  });
                }
                if (confirm.status === "APPROVED" || confirm.status === "COMPLETED") {
                  const cap = await fetch(`${createApi}/api/paypal-create-order`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ action: "capture", orderId }),
                  });
                  if (!cap.ok) throw new Error("Capture failed");
                  saveOrderSnapshot(shippingAmount());
                  clearCart();
                  location.href = `${base}${prefix}grazie/?from=paypal`;
                  return { transactionState: "SUCCESS" };
                }
                return {
                  transactionState: "ERROR",
                  error: { intent: "PAYMENT_AUTHORIZATION", message: "Not approved" },
                };
              } catch (err) {
                console.error("Google Pay authorize", err);
                return {
                  transactionState: "ERROR",
                  error: {
                    intent: "PAYMENT_AUTHORIZATION",
                    message: err instanceof Error ? err.message : "Failed",
                  },
                };
              }
            },
          },
        });

        // Must stay in the click stack (no await before this).
        const pending = client.loadPaymentData(paymentDataRequest);
        if (pending && typeof (pending as Promise<unknown>).catch === "function") {
          (pending as Promise<unknown>).catch((err: unknown) => {
            const code = String((err as { statusCode?: string })?.statusCode || err);
            if (code.includes("CANCELED") || code.includes("AbortError")) return;
            console.error("Google Pay click", err);
            window.alert("Google Pay non è riuscito ad aprire il pagamento. Riprova o usa PayPal.");
          });
        }
      };

      googlePayReady = startGooglePay;

      // Prefer the labeled button (reliable click). Official mark is decorative-optional.
      if (googleFallback) googleFallback.hidden = false;
      if (gpaySdk) {
        gpaySdk.hidden = true;
        gpaySdk.replaceChildren();
      }
    }

    function tryMountButtons() {
      if (buttonsMounted) return;
      if (!(window as unknown as { paypal?: unknown }).paypal) return;
      if (!sanitizeCart().length) return;
      buttonsMounted = true;
      mountButtons();
    }

    if (paypalClientId) {
      const wait = () => {
        if ((window as unknown as { paypal?: unknown }).paypal) tryMountButtons();
        else setTimeout(wait, 80);
      };
      wait();
    }
  </script>
</Base>
