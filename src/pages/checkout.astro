---
import Base from "../layouts/Base.astro";
import FormHoney from "../components/FormHoney.astro";
import { site, formEndpoint } from "../data/site";
import { siteSettings } from "../data/settings";
import { SHIP_COUNTRIES } from "../lib/ship-countries";
import { currentLocale, pageUrl, paypalSdkLocale, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const shopEmail = siteSettings.shopEmail;
const paypalSdk = Boolean(site.paypalClientId);
const orderAction = formEndpoint("order") || `https://formsubmit.co/${shopEmail}`;
const regionNames = new Intl.DisplayNames([locale, "en"], { type: "region" });
const shipCountries = SHIP_COUNTRIES.map((code) => ({
  code,
  label: `${regionNames.of(code) || code} (${code})`,
}));
---

<Base title={`${copy.checkout.title} — Corpoceleste`}>
  <div
    class="wrap page-main page-main--narrow checkout-page"
    data-ship-need-zip={copy.checkout.shippingQuoteNeedZip}
    data-ship-loading={copy.checkout.shippingQuoteLoading}
    data-ship-error={copy.checkout.shippingQuoteError}
  >
    <h1>{copy.checkout.title}</h1>

    <p class="empty" data-checkout-empty hidden>
      {copy.checkout.empty} <a href={pageUrl(locale)}>{copy.nav.shop}</a>
    </p>

    <div class="checkout-flow" data-checkout-flow hidden>
      <section class="checkout-step checkout-step--order">
        <h2 class="checkout-bank-title">{copy.checkout.shipTo}</h2>
        <div class="field checkout-ship">
          <label class="field-label" for="ship-country">{copy.checkout.shipCountry}</label>
          <select id="ship-country" data-ship-country autocomplete="country">
            {
              shipCountries.map(({ code, label }) => (
                <option value={code} selected={code === "IT"}>
                  {label}
                </option>
              ))
            }
          </select>
        </div>
        <div class="checkout-ship-row">
          <div class="field checkout-ship">
            <label class="field-label" for="ship-zip">{copy.checkout.shipZip}</label>
            <input
              id="ship-zip"
              data-ship-zip
              type="text"
              autocomplete="postal-code"
              inputmode="text"
              spellcheck="false"
            />
          </div>
          <div class="field checkout-ship">
            <label class="field-label" for="ship-city">{copy.checkout.city}</label>
            <input id="ship-city" data-ship-city type="text" autocomplete="address-level2" />
          </div>
        </div>
        <p class="checkout-vat" data-ship-status>{copy.checkout.shippingQuoteNeedZip}</p>
        <div class="recap" data-recap></div>
      </section>

      <section class="checkout-step checkout-step--confirm">
        <div class="disclaimer">
          <h3>{copy.checkout.shippingTitle}</h3>
          <p>{copy.checkout.shippingBody}</p>
        </div>
        <p class="checkout-vat">{copy.checkout.vatIncluded}</p>
        <label class="check checkout-check">
          <input type="checkbox" data-disclaimer />
          <span>
            {copy.checkout.termsLead}<a href={pageUrl(locale, "vendita/")}>{copy.checkout.termsLink}</a>{copy.checkout.termsTail}
          </span>
        </label>
        <label class="check checkout-check">
          <input type="checkbox" data-privacy />
          <span>
            {copy.forms.privacyLead}<a href={pageUrl(locale, "privacy/")}>{copy.checkout.privacyLink}</a>{copy.forms.privacyTail}
          </span>
        </label>
        <p class="checkout-lock-hint" data-pay-lock-hint>{copy.checkout.unlockPay}</p>
      </section>

      <section class="checkout-step checkout-step--pay">
        <h2 class="checkout-bank-title">{copy.checkout.payTitle}</h2>

        <div class="pay-methods">
          <label class="check">
            <input
              type="radio"
              name="metodo-pagamento"
              value="paypal"
              checked={paypalSdk}
              data-method
            />
            <span>{copy.checkout.methodPaypal}</span>
          </label>
          <label class="check">
            <input
              type="radio"
              name="metodo-pagamento"
              value="bonifico"
              checked={!paypalSdk}
              data-method
            />
            <span>{copy.checkout.bank}</span>
          </label>
        </div>

        <div data-method-panel="paypal" hidden={!paypalSdk}>
          {
            paypalSdk ? (
              <>
                <p class="checkout-obligation">{copy.checkout.payObligation}</p>
                <div class="pay-box is-locked" data-pay-box>
                  <div class="pay-buttons">
                    <div id="paypal-button" class="pay-buttons__slot"></div>
                    <div id="applepay-button" class="pay-buttons__slot" hidden data-applepay-slot></div>
                  </div>
                  <p class="checkout-vat" data-applepay-hint hidden>
                    {copy.checkout.applePayHint}
                  </p>
                </div>
              </>
            ) : (
              <div class="pay-box">
                <div class="pay-buttons">
                  <button class="btn btn--full" type="button" disabled>
                    {copy.checkout.paypal}
                  </button>
                  <button class="btn btn--full btn--ghost" type="button" disabled>
                    {copy.checkout.applePay}
                  </button>
                </div>
              </div>
            )
          }
        </div>

        <div data-method-panel="bonifico" hidden={paypalSdk}>
          <h3 class="checkout-bank-title">{copy.checkout.bank}</h3>
          <p>{copy.checkout.bankNote}</p>
          <form class="form is-locked" action={orderAction} method="POST" data-checkout-form>
            <input type="hidden" name="_subject" value="Ordine shop Corpoceleste (bonifico)" />
            <input type="hidden" name="_next" data-next-grazie="ordine" />
            <input type="hidden" name="locale" value={locale} />
            <input type="hidden" name="ordine" data-order-field />
            <input type="hidden" name="lines" data-lines-field />
            <input type="hidden" name="shipCountry" data-ship-country-field value="IT" />
            <input type="hidden" name="shipZip" data-ship-zip-field value="" />
            <FormHoney />
            <div>
              <label for="o-name">{copy.checkout.name}</label>
              <input id="o-name" name="nome" required />
            </div>
            <div>
              <label for="o-email">{copy.checkout.email}</label>
              <input id="o-email" type="email" name="email" required />
            </div>
            <div>
              <label for="o-tel">{copy.checkout.phone}</label>
              <input id="o-tel" name="telefono" required />
            </div>
            <div>
              <label for="o-addr">{copy.checkout.address}</label>
              <input id="o-addr" name="indirizzo" required autocomplete="street-address" />
            </div>
            <input type="hidden" name="citta" data-ship-city-field value="" />
            <div>
              <label for="o-note">{copy.checkout.notes}</label>
              <textarea id="o-note" name="note"></textarea>
            </div>
            <input type="hidden" name="privacy" value="presa visione" />
            <button class="btn" type="submit" data-bank-submit disabled>{copy.checkout.sendOrder}</button>
          </form>
        </div>
      </section>
    </div>
  </div>

  {
    paypalSdk && (
      <script define:vars={{ clientId: site.paypalClientId, sdkLocale: paypalSdkLocale[locale] }}>
        const s = document.createElement("script");
        s.src = `https://www.paypal.com/sdk/js?client-id=${encodeURIComponent(clientId)}&currency=EUR&locale=${sdkLocale}&enable-funding=applepay&disable-funding=card,credit,paylater,venmo`;
        document.head.append(s);
      </script>
    )
  }

  <script>
    import { total, clearCart, saveOrderSnapshot, sanitizeCart } from "../scripts/cart";
    import { lineName, renderRecap } from "../scripts/cart-ui";
    import { apiBase, site } from "../data/site";

    const base = import.meta.env.BASE_URL;
    const prefix = document.documentElement.dataset.localePrefix || "";
    const page = document.querySelector<HTMLElement>(".checkout-page");
    const labels = {
      needZip: page?.dataset.shipNeedZip || "",
      loading: page?.dataset.shipLoading || "",
      error: page?.dataset.shipError || "",
    };
    const emptyEl = document.querySelector("[data-checkout-empty]");
    const flowEl = document.querySelector("[data-checkout-flow]");
    const recap = document.querySelector("[data-recap]");
    const countrySel = document.querySelector<HTMLSelectElement>("[data-ship-country]");
    const zipInput = document.querySelector<HTMLInputElement>("[data-ship-zip]");
    const cityInput = document.querySelector<HTMLInputElement>("[data-ship-city]");
    const shipStatus = document.querySelector<HTMLElement>("[data-ship-status]");
    const disclaimer = document.querySelector<HTMLInputElement>("[data-disclaimer]");
    const privacy = document.querySelector<HTMLInputElement>("[data-privacy]");
    const payBox = document.querySelector("[data-pay-box]");
    const bankForm = document.querySelector<HTMLFormElement>("[data-checkout-form]");
    const bankSubmit = document.querySelector<HTMLButtonElement>("[data-bank-submit]");
    const lockHint = document.querySelector<HTMLElement>("[data-pay-lock-hint]");
    const orderField = document.querySelector<HTMLInputElement>("[data-order-field]");
    const linesField = document.querySelector<HTMLInputElement>("[data-lines-field]");
    const shipCountryField = document.querySelector<HTMLInputElement>("[data-ship-country-field]");
    const shipZipField = document.querySelector<HTMLInputElement>("[data-ship-zip-field]");
    const shipCityField = document.querySelector<HTMLInputElement>("[data-ship-city-field]");
    const methods = document.querySelectorAll<HTMLInputElement>("[data-method]");
    const panels = document.querySelectorAll<HTMLElement>("[data-method-panel]");

    type Quote = {
      shipping: number;
      country: string;
      zip: string;
      serviceId: number;
      carrier: string;
    };

    let quote: Quote | null = null;
    let quoteError = false;
    let quoteLoading = false;
    let quoteSeq = 0;
    let quoteTimer: ReturnType<typeof setTimeout> | undefined;

    function normalizeZip(z: string) {
      return z.trim().replace(/\s+/g, "").toUpperCase();
    }

    function destCountry() {
      return String(countrySel?.value || "IT").toUpperCase();
    }

    function destZip() {
      return normalizeZip(zipInput?.value || "");
    }

    function destCity() {
      return String(cityInput?.value || "").trim();
    }

    function shippingAmount() {
      return quote?.shipping ?? 0;
    }

    function hasValidQuote() {
      return Boolean(
        quote && quote.shipping >= 0 && !quoteError && !quoteLoading && destCity(),
      );
    }

    function orderText() {
      const items = sanitizeCart();
      const ship = shippingAmount();
      const lines = items.map((i) => `${lineName(i)} · ${i.size} · ×${i.qty} · ${i.price * i.qty}€`);
      if (hasValidQuote()) {
        const carrier = quote?.carrier ? ` (${quote.carrier})` : "";
        lines.push(`Spedizione ${ship}€${carrier}`, `Totale ${total() + ship}€`);
      } else {
        lines.push("Spedizione: da calcolare", `Totale merce ${total()}€`);
      }
      return lines.join("\n");
    }

    function unlocked() {
      return Boolean(disclaimer?.checked && privacy?.checked && sanitizeCart().length && hasValidQuote());
    }

    function syncLock() {
      const ok = unlocked();
      payBox?.classList.toggle("is-locked", !ok);
      bankForm?.classList.toggle("is-locked", !ok);
      if (bankSubmit) bankSubmit.disabled = !ok;
      if (lockHint) lockHint.hidden = ok;
    }

    function setStatus(text: string) {
      if (shipStatus) shipStatus.textContent = text;
    }

    function syncPage() {
      const items = sanitizeCart();
      const empty = !items.length;
      if (emptyEl) emptyEl.hidden = !empty;
      if (flowEl) flowEl.hidden = empty;
      if (!empty && recap) {
        renderRecap(recap, items, hasValidQuote() ? shippingAmount() : 0);
        if (orderField) orderField.value = orderText();
        if (linesField) {
          linesField.value = JSON.stringify(
            items.map((i) => ({ id: i.id, size: i.size, qty: i.qty })),
          );
        }
        if (shipCountryField) shipCountryField.value = destCountry();
        if (shipZipField) shipZipField.value = destZip();
        if (shipCityField) shipCityField.value = destCity();
      }
      syncLock();
      page?.classList.add("is-ready");
    }

    async function fetchQuote() {
      const items = sanitizeCart();
      const country = destCountry();
      const zip = destZip();
      const createApi = apiBase();

      quote = null;
      quoteError = false;

      if (!items.length) {
        quoteLoading = false;
        setStatus(labels.needZip);
        syncPage();
        return;
      }
      if (!zip || zip.length < 3) {
        quoteLoading = false;
        setStatus(labels.needZip);
        syncPage();
        return;
      }
      if (!createApi) {
        quoteLoading = false;
        quoteError = true;
        setStatus(labels.error);
        syncPage();
        return;
      }

      const seq = ++quoteSeq;
      quoteLoading = true;
      setStatus(labels.loading);
      syncPage();

      try {
        const res = await fetch(`${createApi}/api/shipping-quote`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            country,
            zip,
            lines: items.map((i) => ({ id: i.id, size: i.size, qty: i.qty })),
          }),
        });
        if (seq !== quoteSeq) return;
        if (!res.ok) {
          quoteError = true;
          quote = null;
          setStatus(labels.error);
          syncPage();
          return;
        }
        const data = (await res.json()) as {
          shipping?: string;
          country?: string;
          zip?: string;
          serviceId?: number;
          carrier?: string;
        };
        const shipping = Number(data.shipping);
        if (!Number.isFinite(shipping) || !data.serviceId) {
          quoteError = true;
          quote = null;
          setStatus(labels.error);
          syncPage();
          return;
        }
        quote = {
          shipping,
          country: String(data.country || country).toUpperCase(),
          zip: normalizeZip(String(data.zip || zip)),
          serviceId: Number(data.serviceId),
          carrier: String(data.carrier || ""),
        };
        quoteError = false;
        const carrier = quote.carrier ? ` · ${quote.carrier}` : "";
        setStatus(`${quote.shipping.toFixed(2)} €${carrier}`);
        syncPage();
      } catch (err) {
        if (seq !== quoteSeq) return;
        console.error("shipping-quote", err);
        quoteError = true;
        quote = null;
        setStatus(labels.error);
        syncPage();
      } finally {
        if (seq === quoteSeq) quoteLoading = false;
        syncLock();
      }
    }

    function scheduleQuote() {
      if (quoteTimer) clearTimeout(quoteTimer);
      quoteTimer = setTimeout(() => {
        void fetchQuote();
      }, 400);
    }

    function syncMethod() {
      const chosen = [...methods].find((r) => r.checked)?.value;
      if (!chosen) return;
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.methodPanel !== chosen;
      });
    }

    methods.forEach((radio) => radio.addEventListener("change", syncMethod));
    syncMethod();

    countrySel?.addEventListener("change", () => {
      scheduleQuote();
      syncPage();
    });
    zipInput?.addEventListener("input", () => {
      scheduleQuote();
      syncPage();
    });
    cityInput?.addEventListener("input", () => {
      syncPage();
    });
    disclaimer?.addEventListener("change", syncLock);
    privacy?.addEventListener("change", syncLock);
    window.addEventListener("cart:change", () => {
      scheduleQuote();
      syncPage();
    });

    bankForm?.addEventListener("submit", (e) => {
      sanitizeCart();
      syncPage();
      if (!unlocked()) {
        e.preventDefault();
        return;
      }
      saveOrderSnapshot(shippingAmount());
    });

    syncPage();

    function mountButtons() {
      type Funding = { PAYPAL: string; APPLEPAY: string };
      type ButtonsFactory = (o: object) => {
        render: (s: string) => Promise<void> | void;
        isEligible?: () => boolean;
      };
      const paypal = (
        window as unknown as {
          paypal?: { Buttons: ButtonsFactory; FUNDING: Funding };
        }
      ).paypal;
      if (!paypal?.Buttons || !paypal.FUNDING || !sanitizeCart().length) return;

      const createApi = apiBase();
      if (!createApi) {
        console.warn("PayPal: formApi/apiBase missing — cannot create server orders");
        return;
      }

      const shared = {
        onClick: (_: unknown, actions: { reject: () => Promise<void>; resolve: () => Promise<void> }) => {
          if (!unlocked()) return actions.reject();
          return actions.resolve();
        },
        onShippingAddressChange: async (
          data: {
            shippingAddress?: {
              countryCode?: string;
              postalCode?: string;
            };
          },
          actions: { reject: () => Promise<void>; resolve: () => Promise<void> },
        ) => {
          if (!quote) return actions.reject();
          const country = String(data.shippingAddress?.countryCode || "").toUpperCase();
          const postal = normalizeZip(String(data.shippingAddress?.postalCode || ""));
          if (country && country !== quote.country) return actions.reject();
          if (postal && postal !== quote.zip) return actions.reject();
          return actions.resolve();
        },
        createOrder: async () => {
          const items = sanitizeCart();
          if (!quote) throw new Error("Missing shipping quote");
          const res = await fetch(`${createApi}/api/paypal-create-order`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              lines: items.map((i) => ({ id: i.id, size: i.size, qty: i.qty })),
              country: quote.country,
              zip: quote.zip,
            }),
          });
          if (!res.ok) {
            const err = await res.text();
            console.error("paypal-create-order failed", res.status, err);
            throw new Error("Order create failed");
          }
          const data = (await res.json()) as { id?: string };
          if (!data.id) throw new Error("Missing order id");
          return data.id;
        },
        onApprove: async (_: unknown, actions: { order: { capture: () => Promise<unknown> } }) => {
          saveOrderSnapshot(shippingAmount());
          await actions.order.capture();
          clearCart();
          location.href = `${base}${prefix}grazie/?from=paypal`;
        },
      };

      const paypalNode = document.querySelector("#paypal-button");
      if (paypalNode && !paypalNode.hasChildNodes()) {
        paypal
          .Buttons({ ...shared, fundingSource: paypal.FUNDING.PAYPAL })
          .render("#paypal-button");
      }

      const appleSlot = document.querySelector<HTMLElement>("[data-applepay-slot]");
      const appleHint = document.querySelector<HTMLElement>("[data-applepay-hint]");
      const appleBtn = paypal.Buttons({
        ...shared,
        fundingSource: paypal.FUNDING.APPLEPAY,
      });
      if (appleSlot && appleBtn.isEligible?.() && !appleSlot.hasChildNodes()) {
        appleSlot.hidden = false;
        if (appleHint) appleHint.hidden = true;
        void appleBtn.render("#applepay-button");
      } else if (appleHint) {
        appleHint.hidden = false;
      }
    }

    if (site.paypalClientId) {
      const wait = () => {
        if ((window as unknown as { paypal?: unknown }).paypal) mountButtons();
        else setTimeout(wait, 80);
      };
      wait();
    }
  </script>
</Base>
