---
import Base from "../../layouts/Base.astro";
import { news, formatDate } from "../../data/news";
import { url } from "../../lib/paths";
---

<Base title="News — Corpoceleste">
  <div class="wrap">
    <header class="page-hero">
      <h1>News</h1>
    </header>
    {
      news.length > 0 && (
        <ul class="news-list">
          {news.map((n) => (
            <li>
              <span class="date">{formatDate(n.date)}</span>
              <h2>
                <a href={url(`news/${n.slug}/`)}>{n.title}</a>
              </h2>
              <p>{n.excerpt}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
