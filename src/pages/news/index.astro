---
import Base from "../../layouts/Base.astro";
import { news, newsField } from "../../data/news";
import { mediaUrl } from "../../lib/paths";
import { currentLocale, formatDate, pageUrl, t } from "../../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
---

<Base title={`${copy.news.title} — Corpoceleste`}>
  <div class="wrap page-pad">
    <h1 class="visually-hidden">{copy.news.title}</h1>
    {
      news.length > 0 ? (
        <ul class="news-list">
          {news.map((n) => {
            const cover = n.cover ? mediaUrl(n.cover) : "";
            return (
              <li>
                <div class="news-list__row">
                  {cover && (
                    <a href={pageUrl(locale, `news/${n.slug}/`)}>
                      <img
                        class="news-list__thumb"
                        src={cover}
                        alt={copy.news.imageAlt(newsField(n, locale, "title"))}
                        width="280"
                        height="280"
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  )}
                  <div>
                    <span class="date">{formatDate(n.date, locale)}</span>
                    <h2>
                      <a href={pageUrl(locale, `news/${n.slug}/`)}>{newsField(n, locale, "title")}</a>
                    </h2>
                    <p>{newsField(n, locale, "excerpt")}</p>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="lede">{copy.news.empty}</p>
      )
    }
  </div>
</Base>
