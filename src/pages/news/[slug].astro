---
import Base from "../../layouts/Base.astro";
import { news, newsBySlug, newsField, newsPreviewImage } from "../../data/news";
import { mediaUrl } from "../../lib/paths";
import { currentLocale, formatDate, pageUrl, t } from "../../i18n";

export function getStaticPaths() {
  return news.map((n) => ({ params: { slug: n.slug } }));
}

function linkify(text: string) {
  const escaped = text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
  return escaped.replace(
    /\[([^\]]+)\]\((https?:\/\/[^)\s]+|mailto:[^)\s]+)\)/g,
    (_match, label: string, url: string) => {
      if (/["'<>`]/.test(url) || /javascript:/i.test(url)) {
        return `[${label}](${url})`;
      }
      const href = url.replace(/&/g, "&amp;").replace(/"/g, "&quot;");
      const rel = url.startsWith("mailto:") ? "" : ' rel="noopener noreferrer"';
      return `<a href="${href}"${rel}>${label}</a>`;
    },
  );
}

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const item = newsBySlug(Astro.params.slug!);
if (!item) return Astro.redirect(pageUrl(locale, "news/"));
const title = newsField(item, locale, "title");
const excerpt = newsField(item, locale, "excerpt");
const paras = newsField(item, locale, "body").split(/\n\n+/).filter(Boolean);
const preview = newsPreviewImage(item);
const cover = preview ? mediaUrl(preview) : "";
const videoSrc = item.video ? mediaUrl(item.video) : "";
const gallery = item.images
  .filter((src) => src && src !== preview)
  .map(mediaUrl)
  .filter(Boolean);
---

<Base title={`${title} — Corpoceleste`} description={excerpt} image={preview || undefined}>
  <div class="wrap page-main page-main--article">
    <header class="page-hero">
      <p class="card-artist"><a href={pageUrl(locale, "news/")}>News</a> · {formatDate(item.date, locale)}</p>
      <h1>{title}</h1>
    </header>
    <div class:list={["news-feature", videoSrc && "news-feature--split"]}>
      {
        videoSrc ? (
          <video
            class="news-cover news-cover--video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={cover || undefined}
            aria-label={copy.news.imageAlt(title)}
          >
            <source src={videoSrc} type="video/mp4" />
          </video>
        ) : cover ? (
          <img
            class="news-cover"
            src={cover}
            alt={copy.news.imageAlt(title)}
            width="1200"
            height="800"
            loading="eager"
            decoding="async"
          />
        ) : null
      }
      <div class="prose">
        {paras.map((p) => <p set:html={linkify(p)} />)}
      </div>
    </div>
    {gallery.length > 0 && (
      <div class="news-gallery">
        {gallery.map((src, i) => (
          <img src={src} alt={copy.news.imageAltGallery(title, i + 1)} loading="lazy" decoding="async" />
        ))}
      </div>
    )}
  </div>
</Base>
