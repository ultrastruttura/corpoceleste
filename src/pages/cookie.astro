---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { currentLocale, pageUrl, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const c = copy.cookiePolicy;
---

<Base title={`${c.title} — Corpoceleste`}>
  <div class="wrap">
    <header class="page-hero">
      <h1>{c.title}</h1>
      <p class="lede">{c.lede}</p>
    </header>

    <div class="prose page-main--article">
      <p>{c.updated}</p>

      <h2>{c.noBanner}</h2>
      <p>{c.noBannerBody}</p>

      <h2>{c.onSite}</h2>
      <p>{c.onSiteBody}</p>

      <h2>{c.third}</h2>
      <p>
        {c.thirdBody}
        (<a href="https://www.paypal.com/it/legalhub/paypal/privacy-full" rel="noopener noreferrer">paypal.com</a>).
      </p>

      <h2>{c.manage}</h2>
      <p>{c.manageBody}</p>

      <p>
        <a href={pageUrl(locale, "privacy/")}>{c.privacyLink}</a>
      </p>
      <p>
        {c.contact} <a href={`mailto:${site.email}`}>{site.email}</a>
        ({site.intestatario}, {site.sede}).
      </p>
    </div>
  </div>
</Base>
