---
import Base from "../layouts/Base.astro";
import { url } from "../lib/paths";
---

<Base title="Carrello — Corpoceleste">
  <div class="wrap page-main page-main--cart">
    <h1>Carrello</h1>
    <div class="cart-page-lines" data-cart-page></div>
    <p class="cart-page-total" data-cart-page-total></p>
    <a class="btn" href={url("checkout/")} data-cart-checkout>Checkout</a>
    <a class="btn btn--ghost" href={url()}>Shop</a>
  </div>
</Base>
