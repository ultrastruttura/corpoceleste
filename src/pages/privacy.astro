---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { currentLocale, pageUrl, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const p = copy.privacy;
const formSubmitFallback = !site.formApi;
---

<Base title={`${p.title} — Corpoceleste`}>
  <div class="wrap page-main">
    <header class="page-hero">
      <h1>{p.title}</h1>
      <p class="lede">{p.lede}</p>
    </header>

    <div class="prose page-main--article">
      <p>{p.updated}</p>

      <h2>{p.controller}</h2>
      <p>
        {p.controllerBody(site.intestatario, site.sede)}<br />
        {site.vatId && <>{p.vat(site.vatId)}<br /></>}
        {p.contact} <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>

      <h2>{p.cookies}</h2>
      <p>{p.cookiesP1}</p>
      <p>{p.cookiesP3}</p>
      <p>
        {p.cookiesPaypal}
        (<a href="https://www.paypal.com/it/legalhub/paypal/privacy-full" rel="noopener noreferrer">paypal.com</a>).
      </p>
      <p>
        {p.cookiesMore}
        {" "}
        <a href={pageUrl(locale, "cookie/")}>{p.cookiesMoreLink}</a>.
      </p>

      <h2>{p.data}</h2>
      <p>{p.dataIntro}</p>
      <ul>
        <li>
          <strong>{p.orderBank}</strong> — {p.dataOrder}
        </li>
        <li>
          <strong>{p.payPaypal}</strong> — {p.dataPaypal}
        </li>
        <li>
          <strong>{p.formsLabel}</strong> — {p.dataForms}
        </li>
        <li>
          <strong>{p.newsletter}</strong> — {p.dataNewsletter(site.email)}
        </li>
      </ul>
      <p>{p.noProfiling}</p>

      <h2>{p.recipients}</h2>
      <ul>
        {
          formSubmitFallback && (
            <li>
              <strong>FormSubmit.co</strong> — {p.formsubmit}
              <a href="https://formsubmit.co/" rel="noopener noreferrer">formsubmit.co</a>.
            </li>
          )
        }
        <li>
          <strong>PayPal (Europe) S.à r.l. et Cie, S.C.A.</strong> — {p.paypalRecv}
        </li>
        <li>
          <strong>GitHub Pages (GitHub, Inc. / Microsoft)</strong> — {p.github}
        </li>
        <li>
          <strong>Vercel Inc.</strong> — {p.vercel}
        </li>
        <li>
          <strong>Resend</strong> — {p.resend}
        </li>
        <li>
          <strong>Cloudflare, Inc.</strong> — {p.cloudflare}{" "}
          <a href="https://www.cloudflare.com/privacypolicy/" rel="noopener noreferrer">cloudflare.com</a>.
        </li>
        <li>{p.couriers}</li>
      </ul>
      <h2>{p.transfers}</h2>
      <p>{p.transfersBody}</p>
      <p>{p.noSell}</p>

      <h2>{p.rights}</h2>
      <p>
        {p.rightsBody} <a href={`mailto:${site.email}`}>{site.email}</a>. {p.rightsTail}
        <a href="https://www.garanteprivacy.it" rel="noopener noreferrer">garanteprivacy.it</a>.
      </p>
    </div>
  </div>
</Base>
