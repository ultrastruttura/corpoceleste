---
import Base from "../layouts/Base.astro";
import { asset } from "../lib/paths";
import { metaSnippet } from "../lib/seo";
import { bioField, bioPage } from "../data/bio";
import { currentLocale, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const name = bioPage.name;
const body = bioField("body", locale);
const description = metaSnippet(body || copy.meta.description);
const bodyParas = body.split(/\n\n+/).filter(Boolean);

function escapeHtml(s: string) {
  return s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

/** Safe `[label](https://…)` → anchor; everything else escaped. */
function linkifyBio(s: string) {
  const escaped = escapeHtml(s);
  return escaped.replace(
    /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
    '<a href="$2" rel="noopener noreferrer" target="_blank">$1</a>',
  );
}
---

<Base
  title={`${copy.bio.title} — Corpoceleste`}
  description={description}
  image="images/photos/ultrastruttura.jpg"
>
  <div class="wrap page-pad">
    <header class="page-hero">
      <h1>{copy.bio.title}</h1>
    </header>

    <section class="page-intro">
      <img
        class="page-intro__photo"
        src={asset("images/photos/ultrastruttura.jpg")}
        alt="Ultrastruttura — Se la luce ci prende"
        width="900"
        height="1125"
        loading="eager"
        decoding="async"
      />
      <div class="page-intro__copy">
        {name ? <h2 class="page-intro__title">{name}</h2> : null}
        <div class="page-intro__body bio-body">
          {bodyParas.map((para) => (
            <p set:html={linkifyBio(para)} />
          ))}
        </div>
      </div>
    </section>
  </div>
</Base>
