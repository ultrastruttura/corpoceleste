---
import Base from "../layouts/Base.astro";
import PrivacyCheck from "../components/PrivacyCheck.astro";
import FormHoney from "../components/FormHoney.astro";
import { asset } from "../lib/paths";
import { metaSnippet } from "../lib/seo";
import { bioField, bioPage } from "../data/bio";
import { publicFormAction, site } from "../data/site";
import { siteSettings } from "../data/settings";
import { currentLocale, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const name = bioPage.name;
const body = bioField("body", locale);
const formAction = publicFormAction(siteSettings.shopEmail);
const email = siteSettings.shopEmail || site.email;
const description = metaSnippet(body || copy.meta.description);
const bodyParas = body.split(/\n\n+/).filter(Boolean);

function escapeHtml(s: string) {
  return s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

/** Safe `[label](https://…)` → anchor; everything else escaped. */
function linkifyBio(s: string) {
  const escaped = escapeHtml(s);
  return escaped.replace(
    /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
    '<a href="$2" rel="noopener noreferrer" target="_blank">$1</a>',
  );
}
---

<Base
  title={`${copy.bio.title} — Corpoceleste`}
  description={description}
  image="images/photos/ultrastruttura.jpg"
>
  <div class="wrap page-pad">
    <header class="page-hero">
      <h1>{copy.bio.title}</h1>
    </header>

    <div class="page-intro">
      <img
        class="page-intro__photo"
        src={asset("images/photos/ultrastruttura.jpg")}
        alt="Ultrastruttura — Se la luce ci prende"
        width="900"
        height="1125"
        loading="eager"
        decoding="async"
      />
      <div class="page-intro__copy bio-aside">
        <a
          class="bio-ig"
          href={site.instagram}
          rel="noopener noreferrer"
          target="_blank"
        >
          <svg class="bio-ig__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"></circle>
          </svg>
          <span class="bio-ig__label">Instagram</span>
        </a>
        <p class="bio-aside__email">
          <a href={`mailto:${email}`}>{email}</a>
        </p>
        <div class="bio-aside__newsletter">
          <h2 class="page-intro__title">{copy.privacy.newsletter}</h2>
          <form class="newsletter-form newsletter-form--block" action={formAction} method="POST">
            <input type="hidden" name="_subject" value="Newsletter Corpoceleste" />
            <input type="hidden" name="_next" data-next-grazie="newsletter" />
            <FormHoney />
            <div class="newsletter-row">
              <input
                type="email"
                name="email"
                required
                placeholder={copy.forms.email}
                aria-label={copy.forms.newsletterEmail}
              />
              <button type="submit">{copy.forms.subscribe}</button>
            </div>
            <PrivacyCheck id="bio-nl-privacy" newsletter />
          </form>
        </div>
      </div>
    </div>

    {
      bodyParas.length > 0 && (
        <div class="page-intro__body bio-page-body">
          {name ? <h2 class="page-intro__title">{name}</h2> : null}
          {bodyParas.map((para) => (
            <p set:html={linkifyBio(para)} />
          ))}
        </div>
      )
    }
  </div>
</Base>
