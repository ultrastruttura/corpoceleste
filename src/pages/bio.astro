---
import Base from "../layouts/Base.astro";
import { asset } from "../lib/paths";
import { metaSnippet } from "../lib/seo";
import { bioField, bioPage } from "../data/bio";
import { currentLocale, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const name = bioPage.name;
const body = bioField("body", locale);
const printTitle = bioField("printTitle", locale) || copy.bio.print;
const printBody = bioField("printBody", locale) || copy.bio.printBody;
const printCv = bioField("printCv", locale) || copy.bio.printCv;
const liveTitle = bioField("liveTitle", locale) || copy.bio.live;
const liveBody = bioField("liveBody", locale) || copy.bio.liveBody;
const description = metaSnippet(body || copy.meta.description);
---

<Base
  title={`${copy.bio.title} — Corpoceleste`}
  description={description}
  image="images/photos/andrea.jpg"
>
  <div class="wrap page-pad">
    <header class="page-hero">
      <h1>{copy.bio.title}</h1>
    </header>

    <div class="split">
      <div class="bio-photos">
        <img
          class="page-photo"
          src={asset("images/photos/andrea.jpg")}
          alt={name}
          width="1024"
          height="1024"
          loading="eager"
          decoding="async"
        />
        <img
          class="page-photo"
          src={asset("images/photos/ultrastruttura.jpg")}
          alt="Ultrastruttura — Se la luce ci prende"
          width="1080"
          height="1350"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="prose">
        {
          body && (
            <>
              <h2>{name}</h2>
              {body.split(/\n\n+/).map((para) => (
                <p>{para}</p>
              ))}
            </>
          )
        }
        {printTitle && <h2>{printTitle}</h2>}
        {printBody && <p>{printBody}</p>}
        {printCv && <p>{printCv}</p>}
        {liveTitle && <h2>{liveTitle}</h2>}
        {liveBody && <p>{liveBody}</p>}
      </div>
    </div>
  </div>
</Base>
