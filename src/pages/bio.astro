---
import Base from "../layouts/Base.astro";
import { asset } from "../lib/paths";
import { metaSnippet, personJsonLd } from "../lib/seo";
import { bioField, bioPage } from "../data/bio";
import { currentLocale, t } from "../i18n";

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const name = bioPage.name;
const body = bioField("body", locale);
const description = metaSnippet(body || copy.meta.description);
const bodyParas = body.split(/\n\n+/).filter(Boolean);
const photo = "images/photos/andrea.jpg";

function escapeHtml(s: string) {
  return s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

/** Safe `[label](https://…)` → anchor; everything else escaped. */
function linkifyBio(s: string) {
  const escaped = escapeHtml(s);
  return escaped.replace(
    /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
    '<a href="$2" rel="noopener noreferrer" target="_blank">$1</a>',
  );
}
---

<Base
  title={`${copy.bio.title} — Corpoceleste`}
  description={description}
  image={photo}
  jsonLd={personJsonLd({
    siteUrl: Astro.site,
    name: name || "Andrea Lorenzo Baldelli",
    description: body,
    image: photo,
  })}
>
  <div class="wrap page-pad">
    <h1 class="visually-hidden">{copy.bio.title}</h1>

    <section class="page-intro">
      <img
        class="page-intro__photo"
        src={asset(photo)}
        alt={`${name || "Andrea Lorenzo Baldelli"} — serigrafo Corpoceleste, Bergamo`}
        width="900"
        height="1125"
        loading="eager"
        decoding="async"
      />
      <div class="page-intro__copy">
        {name ? <p class="page-intro__title">{name}</p> : null}
        <div class="page-intro__body bio-body">
          {bodyParas.map((para) => (
            <p set:html={linkifyBio(para)} />
          ))}
        </div>
      </div>
    </section>
  </div>
</Base>
