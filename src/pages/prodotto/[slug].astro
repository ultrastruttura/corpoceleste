---
import Base from "../../layouts/Base.astro";
import {
  productBySlug,
  formatPrice,
  artistName,
  products,
  productDescription,
  productSeoDescription,
  productImageAlt,
  isInStock,
  isLowStock,
  productHasSizes,
  sizeInStock,
  stockOf,
} from "../../data/products";
import { productDescriptionHtml } from "../../lib/product-description";
import { site } from "../../data/site";
import { modelHasSleeve, sizeChartForProduct } from "../../data/fit-models";
import { siteSettings } from "../../data/settings";
import { SHIP_COUNTRIES } from "../../lib/ship-countries";
import { asset, cardImageUrls, largeImageUrls } from "../../lib/paths";
import { absoluteUrl, breadcrumbJsonLd, metaSnippet } from "../../lib/seo";
import { currentLocale, pageAbs, pageUrl, t } from "../../i18n";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const { slug } = Astro.params;
const product = productBySlug(slug!);
if (!product) return Astro.redirect(pageUrl(locale));

const artist = artistName(product.artistId);
const sold = !isInStock(product);
const lowStock = !sold && isLowStock(product, siteSettings.lowStockThreshold);
const preorder = product.status === "preorder" && !sold;
const showSizes = productHasSizes(product);
const alt = productImageAlt(product, artist, locale);
// Always show full garment run (S–XXL); OOS sizes stay visible but disabled.
const sizes = showSizes
  ? [...site.sizes]
  : product.sizes.length
    ? product.sizes
    : ["unica"];
const inStockSizes = sizes.filter((s) => sizeInStock(product, s));
const sizeChart = sizeChartForProduct(product.fitModelId);
const sizeChartHasSleeve = modelHasSleeve(sizeChart.rows);
const defaultSize = showSizes
  ? inStockSizes.includes("M")
    ? "M"
    : inStockSizes[0] ?? sizes[0]
  : sizes[0];
const composition = product.composition
  ? copy.product.compositions[product.composition] ?? product.composition
  : "";
const description = productDescription(product, locale);
const seoDescription = metaSnippet(productSeoDescription(product, locale) || copy.meta.description);
const imageSet = product.images.map((src) => ({
  raw: src,
  ...largeImageUrls(src),
  thumb: cardImageUrls(src),
}));
const cover = imageSet[0];
const multi = imageSet.length > 1;
const pageTitle = `${product.title} — Corpoceleste`;
const productUrl = pageAbs(locale, `prodotto/${product.slug}/`);
const absImages = product.images
  .map((src) => absoluteUrl(largeImageUrls(src).full, Astro.site))
  .filter(Boolean);
/** Google Product rich results require a non-empty image; placeholders have none yet. */
const schemaImages =
  absImages.length > 0
    ? absImages
    : [
        absoluteUrl(product.print || cover?.jpg || siteSettings.ogImage || "brand/favicon.png", Astro.site),
      ].filter(Boolean);

const availability = sold
  ? "https://schema.org/OutOfStock"
  : preorder
    ? "https://schema.org/PreOrder"
    : "https://schema.org/InStock";

/** Indicative rates for Merchant JSON-LD; checkout quotes live via Sendcloud. */
const schemaShipIt = "6.90";
const schemaShipEu = "14.90";
const handlingDays = Math.max(1, Number.parseInt(site.shippingDays, 10) || 5);
const euCountries = SHIP_COUNTRIES.filter((c) => c !== "IT");
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.title,
  description: seoDescription || description,
  image: schemaImages,
  sku: product.id,
  category: "Screen-printed apparel",
  material: composition || undefined,
  brand: {
    "@type": "Brand",
    name: "Corpoceleste",
  },
  ...(artist && artist !== product.title
    ? {
        creator: {
          "@type": "Person",
          name: artist,
        },
      }
    : {}),
  offers: {
    "@type": "Offer",
    url: productUrl,
    priceCurrency: "EUR",
    price: String(product.price),
    availability,
    itemCondition: "https://schema.org/NewCondition",
    seller: {
      "@type": "Organization",
      name: "Corpoceleste",
      url: pageAbs(locale),
    },
    shippingDetails: [
      {
        "@type": "OfferShippingDetails",
        shippingRate: {
          "@type": "MonetaryAmount",
          value: schemaShipIt,
          currency: "EUR",
        },
        shippingDestination: {
          "@type": "DefinedRegion",
          addressCountry: "IT",
        },
        deliveryTime: {
          "@type": "ShippingDeliveryTime",
          handlingTime: {
            "@type": "QuantitativeValue",
            minValue: 1,
            maxValue: handlingDays,
            unitCode: "DAY",
          },
          transitTime: {
            "@type": "QuantitativeValue",
            minValue: 2,
            maxValue: 5,
            unitCode: "DAY",
          },
        },
      },
      {
        "@type": "OfferShippingDetails",
        shippingRate: {
          "@type": "MonetaryAmount",
          value: schemaShipEu,
          currency: "EUR",
        },
        shippingDestination: {
          "@type": "DefinedRegion",
          addressCountry: [...euCountries],
        },
        deliveryTime: {
          "@type": "ShippingDeliveryTime",
          handlingTime: {
            "@type": "QuantitativeValue",
            minValue: 1,
            maxValue: handlingDays,
            unitCode: "DAY",
          },
          transitTime: {
            "@type": "QuantitativeValue",
            minValue: 3,
            maxValue: 8,
            unitCode: "DAY",
          },
        },
      },
    ],
    hasMerchantReturnPolicy: {
      "@type": "MerchantReturnPolicy",
      applicableCountry: [...SHIP_COUNTRIES],
      returnPolicyCategory:
        "https://schema.org/MerchantReturnFiniteReturnWindow",
      merchantReturnDays: 14,
      returnMethod: "https://schema.org/ReturnByMail",
      returnFees: "https://schema.org/ReturnFeesCustomerResponsibility",
      refundType: "https://schema.org/FullRefund",
    },
  },
};
const crumbs = breadcrumbJsonLd(Astro.site, [
  { name: "Corpoceleste", path: pageUrl(locale) },
  { name: product.title, path: pageUrl(locale, `prodotto/${product.slug}/`) },
]);
const jsonLd = product.hidden ? undefined : [productJsonLd, crumbs];
---

<Base
  title={pageTitle}
  description={seoDescription}
  image={product.print || cover?.jpg}
  type="product"
  jsonLd={jsonLd}
  preloadImage={cover?.lg}
  preloadImageType={cover?.lg && /\.webp$/i.test(cover.lg) ? "image/webp" : "image/jpeg"}
  noIndex={Boolean(product.hidden)}
>
  <div class="wrap product-layout">
    <div class:list={["product-stage", sold && "is-sold"]} data-gallery={multi ? "" : undefined}>
      {
        cover ? (
          <div class="product-stage-frame" data-gallery-frame>
            {/* Plain img only — <picture>+fake webp source blocked reliable swaps. */}
            <img
              src={cover.lg}
              alt={alt}
              width="1280"
              height="1280"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              data-product-main
              draggable="false"
            />
            {
              multi && (
                <>
                  <button
                    type="button"
                    class="gallery-hit gallery-hit--prev"
                    data-gallery-prev
                    aria-label={copy.product.galleryPrev}
                  ></button>
                  <button
                    type="button"
                    class="gallery-hit gallery-hit--next"
                    data-gallery-next
                    aria-label={copy.product.galleryNext}
                  ></button>
                </>
              )
            }
          </div>
        ) : (
          <div class="product-stage-frame product-stage-frame--empty" aria-hidden="true" />
        )
      }
      {
        multi && (
          <>
            <p class="gallery-index" data-gallery-index aria-live="polite">
              1 / {imageSet.length}
            </p>
            <div class="product-thumbs" role="tablist" aria-label={product.title}>
              {imageSet.map((img, i) => (
                <button
                  type="button"
                  role="tab"
                  class:list={["product-thumb", i === 0 && "is-active"]}
                  data-product-thumb
                  data-index={i}
                  data-src={img.lg}
                  data-alt={productImageAlt(product, artist, locale, { index: i })}
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-label={`${product.title} ${i + 1}`}
                >
                  <img
                    src={img.thumb.card}
                    alt={productImageAlt(product, artist, locale, { index: i })}
                    width="160"
                    height="160"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              ))}
            </div>
          </>
        )
      }
    </div>
    <div class="product-info">
      {
        product.artistId !== "studio" && artist !== product.title && (
          <p class="card-artist">{artist}</p>
        )
      }
      <h1>{product.title}</h1>
      <div class="price">{formatPrice(product.price)}</div>
      {lowStock && <p class="product-status">{copy.product.lowStock}</p>}
      {preorder && <p class="product-status">{copy.product.preorder}</p>}

      <div class="product-buy">
        {
          sold ? (
            <p class="product-status">{copy.product.sold}</p>
          ) : (
            <form data-add-form>
              <input type="hidden" name="id" value={product.id} />
              <input type="hidden" name="slug" value={product.slug} />
              <input type="hidden" name="title" value={product.title} />
              <input type="hidden" name="price" value={product.price} />
              <input type="hidden" name="color" value="" />
              <input type="hidden" name="print" value={product.print} />
              {
                showSizes ? (
                  <>
                    <fieldset class="size-fieldset">
                      <legend class="field-label">{copy.product.size}</legend>
                      <div class="size-row">
                        {sizes.map((s) => {
                          const available = sizeInStock(product, s);
                          const qty = stockOf(product, s);
                          return (
                            <label class:list={{ "is-oos": !available }}>
                              <input
                                type="radio"
                                name="size"
                                value={s}
                                checked={available && s === defaultSize}
                                disabled={!available}
                              />
                              <span>
                                {s}
                              </span>
                              {available && qty <= 3 && (
                                <span class="visually-hidden">
                                  {copy.product.stockLeft(qty)}
                                </span>
                              )}
                            </label>
                          );
                        })}
                      </div>
                    </fieldset>
                  </>
                ) : (
                  <input type="hidden" name="size" value={defaultSize} />
                )
              }
              <button class="btn" type="submit">{copy.product.add}</button>
            </form>
          )
        }
      </div>

      {
        product.kind === "shirt" && (
          <figure class="care-guide">
            <img
              src={asset("images/guida-lavaggio.webp")}
              alt={copy.product.careGuideAlt}
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </figure>
        )
      }

      {
        description && (
          <div class="product-copy" set:html={productDescriptionHtml(description)} />
        )
      }

      <ul class="attrs">
        {
          composition && (
            <li>
              {composition}
              <span class="attr-note"> — {copy.product.compositionLabel}</span>
            </li>
          )
        }
        <li>{copy.product.printOne}</li>
        <li>{copy.product.shipLine}</li>
        <li>{copy.product.vatIncluded}</li>
      </ul>
      {
        showSizes && sizeChart.rows.length > 0 && (
          <details class="size-chart">
            <summary>
              {copy.product.sizeChart} ({copy.product.sizeUnit})
            </summary>
            <table>
              <thead>
                <tr>
                  <th>{copy.product.size}</th>
                  <th>{copy.product.sizeChest}</th>
                  <th>{copy.product.sizeLength}</th>
                  {sizeChartHasSleeve && (
                    <th>{copy.product.sizeSleeve}</th>
                  )}
                </tr>
              </thead>
              <tbody>
                {sizeChart.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.size}</th>
                    <td>{row.chest}</td>
                    <td>{row.length}</td>
                    {sizeChartHasSleeve && <td>{row.sleeve}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="size-chart-note">{copy.product.sizeChartNote}</p>
            <p class="size-guide-link">
              <a
                href={
                  product.fitModelId
                    ? `${pageUrl(locale, "guida-taglie/")}?model=${encodeURIComponent(product.fitModelId)}`
                    : pageUrl(locale, "guida-taglie/")
                }
              >
                {copy.product.sizeGuideLink}
              </a>
            </p>
          </details>
        )
      }
    </div>
  </div>

  {/* External file: CSP blocks inline page scripts (that is why thumbs did nothing). */}
  <script is:inline src={asset("product-gallery.js")} defer></script>
</Base>
