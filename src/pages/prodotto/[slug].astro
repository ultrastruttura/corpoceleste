---
import Base from "../../layouts/Base.astro";
import PrivacyCheck from "../../components/PrivacyCheck.astro";
import FormHoney from "../../components/FormHoney.astro";
import {
  productBySlug,
  formatPrice,
  artistName,
  products,
  productDescription,
  productSeoDescription,
  productImageAlt,
  isInStock,
  isLowStock,
  sizeInStock,
  stockOf,
} from "../../data/products";
import { artistById } from "../../data/artists";
import { site, publicFormAction } from "../../data/site";
import { siteSettings } from "../../data/settings";
import { cardImageUrls, largeImageUrls } from "../../lib/paths";
import { absoluteUrl, metaSnippet } from "../../lib/seo";
import { currentLocale, pageAbs, pageUrl, t } from "../../i18n";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const { slug } = Astro.params;
const product = productBySlug(slug!);
if (!product) return Astro.redirect(pageUrl(locale));

const artist = artistName(product.artistId);
const artistSlug = artistById(product.artistId)?.slug ?? "corpoceleste";
const sold = !isInStock(product);
const lowStock = !sold && isLowStock(product, siteSettings.lowStockThreshold);
const preorder = product.status === "preorder" && !sold;
const alt = productImageAlt(product, artist, locale);
const sizes = product.sizes.length ? product.sizes : [...site.sizes];
const inStockSizes = sizes.filter((s) => sizeInStock(product, s));
const formAction = publicFormAction(siteSettings.shopEmail);
const defaultSize = inStockSizes.includes("M")
  ? "M"
  : inStockSizes[0] ?? sizes[0];
const color = copy.product.colors[product.colorName] ?? product.colorName;
const composition = product.composition
  ? copy.product.compositions[product.composition] ?? product.composition
  : "";
const description = productDescription(product, locale);
const seoDescription = metaSnippet(productSeoDescription(product, locale) || copy.meta.description);
const imageSet = product.images.map((src) => ({
  raw: src,
  ...largeImageUrls(src),
  thumb: cardImageUrls(src),
}));
const cover = imageSet[0];
const multi = imageSet.length > 1;
const pageTitle = `${product.title} — Corpoceleste`;
const productUrl = pageAbs(locale, `prodotto/${product.slug}/`);
const absImages = product.images
  .map((src) => absoluteUrl(largeImageUrls(src).jpg, Astro.site))
  .filter(Boolean);

const availability = sold
  ? "https://schema.org/OutOfStock"
  : preorder
    ? "https://schema.org/PreOrder"
    : "https://schema.org/InStock";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.title,
  description: seoDescription,
  image: absImages,
  sku: product.id,
  brand: {
    "@type": "Brand",
    name: "Corpoceleste",
  },
  ...(artist && artist !== product.title
    ? {
        creator: {
          "@type": "Person",
          name: artist,
        },
      }
    : {}),
  offers: {
    "@type": "Offer",
    url: productUrl,
    priceCurrency: "EUR",
    price: String(product.price),
    availability,
    itemCondition: "https://schema.org/NewCondition",
  },
};
---

<Base
  title={pageTitle}
  description={seoDescription}
  image={product.print || cover?.jpg}
  type="product"
  jsonLd={jsonLd}
  preloadImage={cover?.webp}
  preloadImageType="image/webp"
>
  <div class="wrap product-layout">
    <div class="product-stage" data-gallery={multi ? "" : undefined}>
      {
        cover && (
          <div class="product-stage-frame" data-gallery-frame>
            <picture>
              <source type="image/webp" srcset={cover.webp} data-product-main-webp />
              <img
                src={cover.jpg}
                alt={alt}
                width="1200"
                height="1200"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                data-product-main
                draggable="false"
              />
            </picture>
            {
              multi && (
                <>
                  <button
                    type="button"
                    class="gallery-hit gallery-hit--prev"
                    data-gallery-prev
                    aria-label={copy.product.galleryPrev}
                  ></button>
                  <button
                    type="button"
                    class="gallery-hit gallery-hit--next"
                    data-gallery-next
                    aria-label={copy.product.galleryNext}
                  ></button>
                  <p class="gallery-index" data-gallery-index aria-live="polite">
                    1 / {imageSet.length}
                  </p>
                </>
              )
            }
          </div>
        )
      }
      {
        multi && (
          <div class="product-thumbs" role="tablist" aria-label={product.title}>
            {imageSet.map((img, i) => (
              <button
                type="button"
                role="tab"
                class:list={["product-thumb", i === 0 && "is-active"]}
                data-product-thumb
                data-index={i}
                data-jpg={img.jpg}
                data-webp={img.webp}
                data-alt={productImageAlt(product, artist, locale, { index: i })}
                aria-selected={i === 0 ? "true" : "false"}
                aria-label={`${product.title} ${i + 1}`}
              >
                <img
                  src={img.thumb.jpg}
                  alt={productImageAlt(product, artist, locale, { index: i })}
                  width="160"
                  height="160"
                  loading="lazy"
                  decoding="async"
                />
              </button>
            ))}
          </div>
        )
      }
    </div>
    <div class="product-info">
      {
        product.artistId !== "studio" && artist !== product.title && (
          <a class="card-artist" href={pageUrl(locale, `artisti/${artistSlug}/`)}>
            {artist}
          </a>
        )
      }
      <h1>{product.title}</h1>
      <div class="price">{formatPrice(product.price)}</div>
      {lowStock && <p class="product-status">{copy.product.lowStock}</p>}
      {preorder && <p class="product-status">{copy.product.preorder}</p>}

      <div class="product-buy">
        {
          sold ? (
            <form class="form" action={formAction} method="POST">
              <input type="hidden" name="_subject" value={`Ristampa: ${product.title}`} />
              <input type="hidden" name="_next" data-next-grazie="ristampa" />
              <input type="hidden" name="prodotto" value={product.title} />
              <FormHoney />
              <p>{copy.product.sold}</p>
              <div>
                <label for="re-email">{copy.forms.email}</label>
                <input id="re-email" type="email" name="email" required />
              </div>
              <div>
                <label for="re-size">{copy.product.size}</label>
                <select id="re-size" name="taglia">
                  {sizes.map((s) => <option>{s}</option>)}
                </select>
              </div>
              <PrivacyCheck id="re-privacy" />
              <button class="btn" type="submit">{copy.product.reprint}</button>
            </form>
          ) : (
            <form data-add-form>
              <input type="hidden" name="id" value={product.id} />
              <input type="hidden" name="slug" value={product.slug} />
              <input type="hidden" name="title" value={product.title} />
              <input type="hidden" name="price" value={product.price} />
              <input type="hidden" name="color" value={product.color} />
              <input type="hidden" name="print" value={product.print} />
              <fieldset class="size-fieldset">
                <legend class="field-label">{copy.product.size}</legend>
                <div class="size-row">
                  {sizes.map((s) => {
                    const available = sizeInStock(product, s);
                    const qty = stockOf(product, s);
                    return (
                      <label class:list={{ "is-oos": !available }}>
                        <input
                          type="radio"
                          name="size"
                          value={s}
                          checked={s === defaultSize}
                          disabled={!available}
                        />
                        <span>
                          {s}
                          {!available && (
                            <span class="size-oos"> · {copy.product.sizeOut}</span>
                          )}
                        </span>
                        {available && qty <= 3 && (
                          <span class="visually-hidden">
                            {copy.product.stockLeft(qty)}
                          </span>
                        )}
                      </label>
                    );
                  })}
                </div>
              </fieldset>
              <button class="btn" type="submit">{copy.product.add}</button>
            </form>
          )
        }
      </div>

      {
        description && (
          <div class="product-copy">
            {description.split(/\n\n+/).map((para) => <p>{para}</p>)}
          </div>
        )
      }

      <ul class="attrs">
        <li>{color}</li>
        {
          composition && (
            <li>
              {composition}
              <span class="attr-note"> — {copy.product.compositionLabel}</span>
            </li>
          )
        }
        <li>{copy.product.printOne}</li>
        <li>{copy.product.shipLine(site.shippingItaly, site.shippingEU)}</li>
        <li>{copy.product.vatIncluded}</li>
      </ul>
      {
        product.kind === "shirt" && (
          <details class="size-chart">
            <summary>{copy.product.sizeChart} ({copy.product.sizeUnit})</summary>
            <table>
              <thead>
                <tr>
                  <th>{copy.product.size}</th>
                  <th>{copy.product.sizeChest}</th>
                  <th>{copy.product.sizeLength}</th>
                  <th>{copy.product.sizeSleeve}</th>
                </tr>
              </thead>
              <tbody>
                {site.sizeChart.map((row) => (
                  <tr>
                    <th scope="row">{row.size}</th>
                    <td>{row.chest}</td>
                    <td>{row.length}</td>
                    <td>{row.sleeve}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="size-chart-note">{copy.product.sizeChartNote}</p>
          </details>
        )
      }
    </div>
  </div>

  <script>
    const root = document.querySelector<HTMLElement>("[data-gallery]");
    const main = document.querySelector<HTMLImageElement>("[data-product-main]");
    const mainWebp = document.querySelector<HTMLSourceElement>("[data-product-main-webp]");
    const indexEl = document.querySelector<HTMLElement>("[data-gallery-index]");
    const thumbs = [...document.querySelectorAll<HTMLButtonElement>("[data-product-thumb]")];
    if (!main || thumbs.length < 2) {
      /* single image: nothing to wire */
    } else {
      let i = 0;
      const total = thumbs.length;

      const show = (next: number) => {
        i = ((next % total) + total) % total;
        const btn = thumbs[i];
        const jpg = btn.dataset.jpg;
        const webp = btn.dataset.webp;
        if (!jpg) return;
        main.src = jpg;
        if (mainWebp && webp) mainWebp.srcset = webp;
        if (btn.dataset.alt) main.alt = btn.dataset.alt;
        thumbs.forEach((t, n) => {
          const on = n === i;
          t.classList.toggle("is-active", on);
          t.setAttribute("aria-selected", on ? "true" : "false");
        });
        if (indexEl) indexEl.textContent = `${i + 1} / ${total}`;
      };

      thumbs.forEach((btn) => {
        btn.addEventListener("click", () => show(Number(btn.dataset.index) || 0));
      });

      document.querySelector("[data-gallery-prev]")?.addEventListener("click", (e) => {
        e.stopPropagation();
        show(i - 1);
      });
      document.querySelector("[data-gallery-next]")?.addEventListener("click", (e) => {
        e.stopPropagation();
        show(i + 1);
      });

      const frame = document.querySelector<HTMLElement>("[data-gallery-frame]");
      let x0: number | null = null;
      frame?.addEventListener(
        "touchstart",
        (e) => {
          x0 = e.changedTouches[0]?.clientX ?? null;
        },
        { passive: true, capture: true },
      );
      frame?.addEventListener(
        "touchend",
        (e) => {
          if (x0 == null) return;
          const dx = (e.changedTouches[0]?.clientX ?? x0) - x0;
          x0 = null;
          if (Math.abs(dx) < 40) return;
          show(i + (dx < 0 ? 1 : -1));
        },
        { passive: true, capture: true },
      );

      root?.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") {
          e.preventDefault();
          show(i - 1);
        }
        if (e.key === "ArrowRight") {
          e.preventDefault();
          show(i + 1);
        }
      });
      if (root && !root.hasAttribute("tabindex")) root.tabIndex = 0;
    }
  </script>
</Base>
