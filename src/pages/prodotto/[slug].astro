---
import Base from "../../layouts/Base.astro";
import PrivacyCheck from "../../components/PrivacyCheck.astro";
import { Image } from "astro:assets";
import { productBySlug, formatPrice, artistName, products } from "../../data/products";
import { artistById } from "../../data/artists";
import { site } from "../../data/site";
import { printImage } from "../../lib/prints";
import { url } from "../../lib/paths";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = productBySlug(slug!);
if (!product) return Astro.redirect(url());

const artist = artistName(product.artistId);
const artistSlug = artistById(product.artistId)?.slug ?? "corpoceleste";
const sold = product.status === "soldout";
const alt = artist !== product.title ? `${artist}, ${product.title}` : product.title;
const sizes = product.sizes.length ? product.sizes : [...site.sizes];
const defaultSize = sizes.includes("M") ? "M" : sizes[0];
---

<Base title={`${product.title} — Corpoceleste`}>
  <div class="wrap product-layout">
    <div class="product-stage">
      <Image
        src={printImage(product.print)}
        alt={alt}
        widths={[800, 1200, 1600]}
        sizes="(max-width: 899px) 100vw, 55vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="product-info">
      {
        product.artistId !== "studio" && artist !== product.title && (
          <a class="card-artist" href={url(`artisti/${artistSlug}/`)}>
            {artist}
          </a>
        )
      }
      <h1>{product.title}</h1>
      <div class="price">{formatPrice(product.price)}</div>
      {product.description && <p>{product.description}</p>}

      {
        sold ? (
          <form class="form" action={`https://formsubmit.co/${site.email}`} method="POST">
            <input type="hidden" name="_subject" value={`Ristampa: ${product.title}`} />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_next" data-next-grazie="ristampa" />
            <input type="hidden" name="prodotto" value={product.title} />
            <p>Esaurita.</p>
            <div>
              <label for="re-email">Email</label>
              <input id="re-email" type="email" name="email" required />
            </div>
            <div>
              <label for="re-size">Taglia</label>
              <select id="re-size" name="taglia">
                {sizes.map((s) => <option>{s}</option>)}
              </select>
            </div>
            <PrivacyCheck id="re-privacy" />
            <button class="btn" type="submit">Richiedi ristampa</button>
          </form>
        ) : (
          <form data-add-form>
            <input type="hidden" name="id" value={product.id} />
            <input type="hidden" name="slug" value={product.slug} />
            <input type="hidden" name="title" value={product.title} />
            <input type="hidden" name="price" value={product.price} />
            <input type="hidden" name="color" value={product.color} />
            <input type="hidden" name="print" value={product.print} />
            <fieldset class="size-fieldset">
              <legend class="field-label">Taglia</legend>
              <div class="size-row">
                {sizes.map((s) => (
                  <label>
                    <input type="radio" name="size" value={s} checked={s === defaultSize} />
                    <span>{s}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <button class="btn" type="submit">Aggiungi al carrello</button>
          </form>
        )
      }

      <ul class="attrs">
        <li>{product.colorName}</li>
        <li>Serigrafia, un colore</li>
        <li>Spedizione Italia {site.shippingItaly} €, Europa {site.shippingEU} €</li>
      </ul>
    </div>
  </div>
</Base>
