---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SiteAnnounce from "../components/SiteAnnounce.astro";
import { asset } from "../lib/paths";
import { absoluteUrl, organizationJsonLd, websiteJsonLd } from "../lib/seo";
import { llmsFullTxtUrl, llmsTxtUrl } from "../lib/llms";
import { products, artistName, productImageAlt } from "../data/products";
import { localizedSetting, siteSettings } from "../data/settings";
import { commerce } from "../data/commerce";
import { site } from "../data/site";
import { currentLocale, innerPath, localePrefix, locales, pageAbs, pageUrl, t } from "../i18n";
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
  image?: string;
  /** Absolute or site-relative MP4 for platforms that embed og:video (not WhatsApp). */
  video?: string;
  type?: "website" | "product" | "video.other";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  preloadImage?: string;
  preloadImageType?: string;
  /** Hide from search engines (account, etc.). */
  noIndex?: boolean;
};

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const defaultDescription =
  localizedSetting("metaDescription", locale) || copy.meta.description;
const {
  title,
  description = defaultDescription,
  image = siteSettings.ogImage,
  video,
  type = "website",
  jsonLd,
  preloadImage,
  preloadImageType = "image/webp",
  noIndex = false,
} = Astro.props;
const apiOrigin = (() => {
  try {
    return commerce.formApi ? new URL(commerce.formApi).origin : "";
  } catch {
    return "";
  }
})();
/** GitHub Pages cannot set HTTP headers — meta CSP is the practical layer. */
/** frame-ancestors is ignored in <meta>; omit it (GH Pages can't set CSP headers). */
const csp = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "script-src 'self' https://challenges.cloudflare.com https://www.paypal.com https://www.sandbox.paypal.com https://www.paypalobjects.com https://pay.google.com https://www.gstatic.com https://cloud.umami.is",
  "style-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.gstatic.com",
  "img-src 'self' data: blob: https:",
  "font-src 'self' data: https://www.gstatic.com",
  `connect-src 'self' ${apiOrigin} https://challenges.cloudflare.com https://api.zippopotam.us https://www.paypal.com https://www.sandbox.paypal.com https://api.paypal.com https://api.sandbox.paypal.com https://www.paypalobjects.com https://pay.google.com https://google.com https://www.google.com https://payments.google.com https://www.gstatic.com https://cloud.umami.is https://gateway.umami.is`.replace(
    /\s+/g,
    " ",
  ),
  "frame-src https://challenges.cloudflare.com https://www.paypal.com https://www.sandbox.paypal.com https://www.paypalobjects.com https://pay.google.com https://*.google.com https://www.gstatic.com",
  `form-action 'self' ${apiOrigin}`.trim(),
]
  .filter(Boolean)
  .join("; ");
const canonical = new URL(Astro.url.pathname, Astro.site);
const rest = innerPath(Astro.url.pathname);
const prefix = localePrefix(locale);
/* Favicon (192px) is below Facebook's 200px minimum — fall back to the 1200×1200 stage frame. */
const ogSrc = image || siteSettings.ogImage || "videos/og-stage.jpg";
const ogImage = absoluteUrl(ogSrc, Astro.site);
const ogIsStage = ogSrc.replace(/^\//, "") === "videos/og-stage.jpg";
const ogVideo = video ? absoluteUrl(video, Astro.site) : "";
const ogType = ogVideo ? "video.other" : type === "product" ? "product" : "website";
const catalog = {
  products: products.map((p) => ({
    id: p.id,
    title: p.title,
    artistName: artistName(p.artistId),
    sizes: p.sizes,
    stock: p.stock,
    price: p.price,
    status: p.status,
    print: p.print,
    imageAlt: productImageAlt(p, artistName(p.artistId), locale),
  })),
};
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const jsonLdBlocks = [
  organizationJsonLd(Astro.site),
  websiteJsonLd(Astro.site),
  ...pageJsonLd,
];
const llmsLocale = locale === "en" || locale === "de" ? locale : "it";
const llmsHref = llmsTxtUrl(llmsLocale);
const llmsFullHref = llmsFullTxtUrl(llmsLocale);
const umamiId = siteSettings.umamiWebsiteId;
const turnstileKey = String(site.turnstileSiteKey || "").trim();
---

<!doctype html>
<html
  lang={locale}
  data-locale={locale}
  data-locale-prefix={prefix}
  data-api={commerce.formApi || undefined}
  data-turnstile={turnstileKey || undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical.href} />
    {locales.map((code) => <link rel="alternate" hreflang={code} href={pageAbs(code, rest)} />)}
    <link rel="alternate" hreflang="x-default" href={pageAbs("it", rest)} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Corpoceleste" />
    <meta property="og:locale" content={locale === "it" ? "it_IT" : locale === "de" ? "de_DE" : "en_GB"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogIsStage && <meta property="og:image:type" content="image/jpeg" />}
    {ogIsStage && <meta property="og:image:width" content="1200" />}
    {ogIsStage && <meta property="og:image:height" content="1200" />}
    {
      ogVideo && (
        <>
          <meta property="og:video" content={ogVideo} />
          <meta property="og:video:secure_url" content={ogVideo} />
          <meta property="og:video:type" content="video/mp4" />
          <meta property="og:video:width" content="960" />
          <meta property="og:video:height" content="960" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          type={preloadImageType}
          fetchpriority="high"
        />
      )
    }
    <!-- Google Search: multipli di 48px, almeno 48×48; sorgente nitida da logo-stella -->
    <link rel="icon" href={asset("brand/favicon-48.png")} type="image/png" sizes="48x48" />
    <link rel="icon" href={asset("brand/favicon-96.png")} type="image/png" sizes="96x96" />
    <link rel="icon" href={asset("brand/favicon-192.png")} type="image/png" sizes="192x192" />
    <link rel="icon" href={asset("brand/favicon.png")} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={asset("brand/apple-touch-icon.png")} sizes="180x180" />
    <link rel="describedby" href={llmsHref} type="text/plain" title="llms.txt" />
    <link rel="alternate" href={llmsHref} type="text/plain" title="llms.txt" />
    <link rel="alternate" href={llmsFullHref} type="text/plain" title="llms-full.txt" />
    <link rel="alternate" href={llmsTxtUrl("it")} type="text/plain" title="llms.txt (it)" hreflang="it" />
    <link rel="alternate" href={llmsTxtUrl("en")} type="text/plain" title="llms.txt (en)" hreflang="en" />
    <link rel="alternate" href={llmsTxtUrl("de")} type="text/plain" title="llms.txt (de)" hreflang="de" />
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.nav.skip}</a>
    <div class="site-chrome">
      <SiteAnnounce />
      <Header />
    </div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <div class="drawer-bg" data-cart-bg></div>
    <aside
      class="drawer"
      data-cart-drawer
      role="dialog"
      aria-labelledby="cart-title"
      aria-hidden="true"
      inert
    >
      <div class="drawer-head">
        <span id="cart-title">{copy.cart.title}</span>
        <button class="icon-btn" type="button" data-close-cart aria-label={copy.cart.close}>✕</button>
      </div>
      <div class="drawer-body" data-cart-lines>
        <p class="empty">{copy.cart.empty}</p>
      </div>
      <div class="drawer-foot">
        <p class="drawer-total" data-cart-total></p>
        <a class="btn btn--full" href={pageUrl(locale, "checkout/")} data-cart-checkout hidden>
          {copy.cart.checkout}
        </a>
        <a class="btn btn--ghost btn--full" href={pageUrl(locale, "carrello/")} data-cart-page-link>
          {copy.cart.viewPage}
        </a>
      </div>
    </aside>

    <script type="application/json" id="cc-catalog" set:html={JSON.stringify(catalog)} />

    <script>
      import "../scripts/shop.ts";
    </script>
    {
      turnstileKey && (
        <script
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        />
      )
    }
    {
      umamiId && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={umamiId}
        />
      )
    }
  </body>
</html>
