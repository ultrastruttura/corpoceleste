---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { asset } from "../lib/paths";
import { absoluteUrl } from "../lib/seo";
import { llmsTxtUrl } from "../lib/llms";
import { products, artistName, productImageAlt } from "../data/products";
import { localizedSetting, siteSettings } from "../data/settings";
import { site } from "../data/site";
import { currentLocale, innerPath, localePrefix, locales, pageAbs, pageUrl, t } from "../i18n";
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "product";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  preloadImage?: string;
  preloadImageType?: string;
  /** Hide from search engines (account, etc.). */
  noIndex?: boolean;
};

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const defaultDescription =
  localizedSetting("metaDescription", locale) || copy.meta.description;
const {
  title,
  description = defaultDescription,
  image = siteSettings.ogImage,
  type = "website",
  jsonLd,
  preloadImage,
  preloadImageType = "image/webp",
  noIndex = false,
} = Astro.props;
const apiOrigin = (() => {
  try {
    return site.formApi ? new URL(site.formApi).origin : "";
  } catch {
    return "";
  }
})();
/** GitHub Pages cannot set HTTP headers — meta CSP is the practical layer. */
const csp = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "frame-ancestors 'none'",
  "script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.paypal.com https://www.sandbox.paypal.com https://www.paypalobjects.com https://static.cloudflareinsights.com",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob: https:",
  "font-src 'self' data:",
  `connect-src 'self' ${apiOrigin} https://www.paypal.com https://www.sandbox.paypal.com https://api.paypal.com https://api.sandbox.paypal.com https://www.paypalobjects.com https://static.cloudflareinsights.com https://cloudflareinsights.com`.replace(
    /\s+/g,
    " ",
  ),
  "frame-src https://www.paypal.com https://www.sandbox.paypal.com https://www.paypalobjects.com",
  `form-action 'self' ${apiOrigin}`.trim(),
]
  .filter(Boolean)
  .join("; ");
const canonical = new URL(Astro.url.pathname, Astro.site);
const rest = innerPath(Astro.url.pathname);
const prefix = localePrefix(locale);
const ogImage = absoluteUrl(image || siteSettings.ogImage || "brand/favicon.png", Astro.site);
const catalog = {
  products: products.map((p) => ({
    id: p.id,
    title: p.title,
    artistName: artistName(p.artistId),
    sizes: p.sizes,
    stock: p.stock,
    price: p.price,
    status: p.status,
    print: p.print,
    imageAlt: productImageAlt(p, artistName(p.artistId), locale),
  })),
};
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const llmsHref = llmsTxtUrl(locale === "en" ? "en" : "it");
const cfToken = siteSettings.cloudflareAnalyticsToken;
const cfBeacon = cfToken ? JSON.stringify({ token: cfToken, spa: false }) : "";
---

<!doctype html>
<html lang={locale} data-locale={locale} data-locale-prefix={prefix}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical.href} />
    {locales.map((code) => <link rel="alternate" hreflang={code} href={pageAbs(code, rest)} />)}
    <link rel="alternate" hreflang="x-default" href={pageAbs("it", rest)} />
    <meta property="og:type" content={type === "product" ? "product" : "website"} />
    <meta property="og:site_name" content="Corpoceleste" />
    <meta property="og:locale" content={locale === "it" ? "it_IT" : locale === "de" ? "de_DE" : "en_GB"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          type={preloadImageType}
          fetchpriority="high"
        />
      )
    }
    <link rel="icon" href={asset("brand/favicon.png")} type="image/png" sizes="128x128" />
    <link rel="describedby" href={llmsHref} type="text/plain" title="llms.txt" />
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.nav.skip}</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <div class="drawer-bg" data-cart-bg></div>
    <aside
      class="drawer"
      data-cart-drawer
      role="dialog"
      aria-labelledby="cart-title"
      aria-hidden="true"
      inert
    >
      <div class="drawer-head">
        <span id="cart-title">{copy.cart.title}</span>
        <button class="icon-btn" type="button" data-close-cart aria-label={copy.cart.close}>✕</button>
      </div>
      <div class="drawer-body" data-cart-lines>
        <p class="empty">{copy.cart.empty}</p>
      </div>
      <div class="drawer-foot">
        <p class="drawer-total" data-cart-total></p>
        <a class="btn btn--full" href={pageUrl(locale, "checkout/")} data-cart-checkout hidden>
          {copy.cart.checkout}
        </a>
        <a class="btn btn--ghost btn--full" href={pageUrl(locale, "carrello/")} data-cart-page-link>
          {copy.cart.viewPage}
        </a>
      </div>
    </aside>

    <script define:vars={{ catalog }}>
      window.__catalog = catalog;
    </script>

    <script>
      import "../scripts/shop.ts";
    </script>
    {
      cfBeacon && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={cfBeacon}
        />
      )
    }
  </body>
</html>
