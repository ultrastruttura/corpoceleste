---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { asset } from "../lib/paths";
import { products, artistName } from "../data/products";
import { currentLocale, innerPath, localePrefix, locales, pageAbs, pageUrl, t } from "../i18n";
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
};

const locale = currentLocale(Astro.currentLocale);
const copy = t(locale);
const { title, description = copy.meta.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const rest = innerPath(Astro.url.pathname);
const prefix = localePrefix(locale);
const catalog = {
  products: products.map((p) => ({
    id: p.id,
    title: p.title,
    artistName: artistName(p.artistId),
    sizes: p.sizes,
  })),
};
---

<!doctype html>
<html lang={locale} data-locale={locale} data-locale-prefix={prefix}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {locales.map((code) => <link rel="alternate" hreflang={code} href={pageAbs(code, rest)} />)}
    <link rel="alternate" hreflang="x-default" href={pageAbs("it", rest)} />
    <link rel="icon" href={asset("brand/favicon.png")} type="image/png" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <div class="drawer-bg" data-cart-bg></div>
    <aside
      class="drawer"
      data-cart-drawer
      role="dialog"
      aria-labelledby="cart-title"
      aria-hidden="true"
      inert
    >
      <div class="drawer-head">
        <span id="cart-title">{copy.cart.title}</span>
        <button class="icon-btn" type="button" data-close-cart aria-label={copy.cart.close}>✕</button>
      </div>
      <div class="drawer-body" data-cart-lines>
        <p class="empty">{copy.cart.empty}</p>
      </div>
      <div class="drawer-foot">
        <p class="drawer-total" data-cart-total></p>
        <a class="btn btn--full" href={pageUrl(locale, "checkout/")} data-cart-checkout hidden>
          {copy.cart.checkout}
        </a>
      </div>
    </aside>

    <script define:vars={{ catalog }}>
      window.__catalog = catalog;
    </script>

    <script>
      import "../scripts/shop.ts";
    </script>
  </body>
</html>
