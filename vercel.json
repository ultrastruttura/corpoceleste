{
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm install --omit=dev",
  "crons": [
    {
      "path": "/api/cron-stock-release",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/cron-stock-release",
      "destination": "/api/form?job=stock_release"
    }
  ],
  "functions": {
    "api/paypal-webhook.ts": { "memory": 256, "maxDuration": 60 },
    "api/paypal-create-order.ts": { "memory": 256, "maxDuration": 20 },
    "api/shipping-quote.ts": { "memory": 256, "maxDuration": 20 },
    "api/order.ts": { "memory": 256, "maxDuration": 20 },
    "api/withdrawal.ts": { "memory": 256, "maxDuration": 15 },
    "api/form.ts": { "memory": 256, "maxDuration": 15 },
    "api/sendcloud-webhook.ts": { "memory": 256, "maxDuration": 15 },
    "api/account/auth.ts": { "memory": 256, "maxDuration": 15 },
    "api/account/users.ts": { "memory": 256, "maxDuration": 15 },
    "api/account/deals.ts": { "memory": 256, "maxDuration": 15 },
    "api/account/sales.ts": { "memory": 256, "maxDuration": 15 },
    "api/account/settle.ts": { "memory": 256, "maxDuration": 15 },
    "api/account/orders.ts": { "memory": 256, "maxDuration": 15 }
  }
}
