# PayPal (developer.paypal.com → app Live o Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# sandbox | live (default live)
PAYPAL_MODE=live
# Opzionale override, es. https://api-m.sandbox.paypal.com
# PAYPAL_API_BASE=

# Email transazionali (conferma d'ordine e avviso recesso) — Resend, mittente tuo
# Crea account su resend.com, verifica il dominio, poi:
RESEND_API_KEY=
MAIL_FROM=Corpoceleste <info@corpoceleste.eu>

# Email shop (destinatario interno su Vercel) — tutti i form / avvisi ordini
SHOP_EMAIL=info@corpoceleste.eu
# Admin portal (obbligatorio, solo questa email è admin — non usare SHOP_EMAIL)
PORTAL_ADMIN_EMAIL=admin@example.com
# PORTAL_ADMIN_NAME=Admin
# Never set on Vercel production/preview — local only
# PORTAL_DEV_LINKS=1

# Base URL del sito: usata nei link di recesso/condizioni della conferma d'ordine
SITE_URL=https://www.corpoceleste.eu
# URL pubblico delle API Vercel (conferma newsletter, ecc.). Default: https://corpoceleste.vercel.app
# SITE_API_URL=https://corpoceleste.vercel.app

# Cron Vercel (rilascio stock bonifico 5gg / hold PayPal scaduti). Vercel lo manda come Bearer.
CRON_SECRET=

# GitHub — token con permesso Contents: Read and write sul repo
GITHUB_TOKEN=
GITHUB_REPO=ultrastruttura/corpoceleste
GITHUB_BRANCH=main

# SpedirePRO — Impostazioni → App e Integrazioni → API
# Docs: https://spedirepro.readme.io/reference/autenticazione-e-webhook
SPEDIRE_API_KEY=
# Default: https://www.spedirepro.com/public-api
# SPEDIRE_API_BASE=https://www.spedirepro.com/public-api
SPEDIRE_FROM_COUNTRY=IT
SPEDIRE_FROM_PROVINCE=
SPEDIRE_FROM_ZIP=
SPEDIRE_FROM_CITY=
SPEDIRE_FROM_ADDRESS=
SPEDIRE_FROM_NAME=Andrea Baldelli
SPEDIRE_FROM_PHONE=
SPEDIRE_FROM_EMAIL=info@corpoceleste.eu
# Shared secret for POST /api/spedire-webhook (header x-spedire-secret or ?secret=)
SPEDIRE_WEBHOOK_SECRET=
# Se PayPal non passa il telefono del buyer, fallback per create-label
# SPEDIRE_DEFAULT_TO_PHONE=
# Pacco default maglie (cm / kg a pezzo) — length → depth in API
# SPEDIRE_PKG_WIDTH=35
# SPEDIRE_PKG_HEIGHT=25
# SPEDIRE_PKG_LENGTH=8
# SPEDIRE_PKG_WEIGHT=0.4
