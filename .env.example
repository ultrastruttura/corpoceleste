# PayPal (developer.paypal.com → app Live o Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# sandbox | live (default live)
PAYPAL_MODE=live
# Opzionale override, es. https://api-m.sandbox.paypal.com
# PAYPAL_API_BASE=

# Email transazionali (conferma d'ordine e avviso recesso) — Resend, mittente tuo
# Crea account su resend.com, verifica il dominio, poi:
RESEND_API_KEY=
MAIL_FROM=Corpoceleste <info@corpoceleste.eu>

# Email shop (destinatario interno su Vercel) — tutti i form / avvisi ordini
SHOP_EMAIL=info@corpoceleste.eu
# Admin portal (obbligatorio, solo questa email è admin — non usare SHOP_EMAIL)
PORTAL_ADMIN_EMAIL=admin@example.com
# PORTAL_ADMIN_NAME=Admin
# Never set on Vercel production/preview — local only
# PORTAL_DEV_LINKS=1

# Base URL del sito: usata nei link di recesso/condizioni della conferma d'ordine
SITE_URL=https://www.corpoceleste.eu
# URL pubblico delle API Vercel (conferma newsletter, ecc.). Default: https://corpoceleste.vercel.app
# SITE_API_URL=https://corpoceleste.vercel.app

# Cron Vercel (rilascio hold PayPal 30 min / bank legacy 48h). Vercel lo manda come Bearer.
CRON_SECRET=

# HMAC newsletter confirm / unsubscribe links (required — no fallback)
NEWSLETTER_SECRET=
# Resend → Segments → create "Newsletter Corpoceleste" → paste Segment ID (Broadcasts)
# RESEND_NEWSLETTER_SEGMENT_ID=

# Portal DB + durable abuse limits (required on Vercel production/preview)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# PORTAL_CORS_ORIGINS=https://www.corpoceleste.eu,http://localhost:4321

# TinaCMS Cloud (admin)
# NEXT_PUBLIC_TINA_CLIENT_ID=
# TINA_TOKEN=

# GitHub — token con permesso Contents: Read and write sul repo
GITHUB_TOKEN=
GITHUB_REPO=ultrastruttura/corpoceleste
GITHUB_BRANCH=main

# Sendcloud — Settings → Integrations → API credentials
# Docs: https://sendcloud.dev (API v3, Basic Auth public:secret)
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
# Optional: force a specific carrier contract on announce
# SENDCLOUD_CONTRACT_ID=
# Prefer studio pickup over dropoff-at-Poste when both exist (default 1)
# SENDCLOUD_PREFER_PICKUP=1
SENDCLOUD_FROM_COUNTRY=IT
SENDCLOUD_FROM_PROVINCE=
SENDCLOUD_FROM_ZIP=
SENDCLOUD_FROM_CITY=
SENDCLOUD_FROM_ADDRESS=
SENDCLOUD_FROM_NAME=Andrea Baldelli
SENDCLOUD_FROM_PHONE=
SENDCLOUD_FROM_EMAIL=info@corpoceleste.eu
# Optional override for webhook HMAC (default = SENDCLOUD_SECRET_KEY / Sendcloud-Signature)
# SENDCLOUD_WEBHOOK_SECRET=
# Se PayPal non passa il telefono del buyer, fallback per announce
# SENDCLOUD_DEFAULT_TO_PHONE=
# Pacco default maglie (cm / kg a pezzo)
# SENDCLOUD_PKG_WIDTH=35
# SENDCLOUD_PKG_HEIGHT=25
# SENDCLOUD_PKG_LENGTH=8
# SENDCLOUD_PKG_WEIGHT=0.4
