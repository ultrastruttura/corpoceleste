# PayPal (developer.paypal.com → app Live o Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# sandbox | live (default live)
PAYPAL_MODE=live
# Opzionale override, es. https://api-m.sandbox.paypal.com
# PAYPAL_API_BASE=

# Email transazionali (conferma d'ordine e avviso recesso) — Resend, mittente tuo
# Crea account su resend.com, verifica il dominio, poi:
RESEND_API_KEY=
MAIL_FROM=Corpoceleste <info@corpoceleste.eu>

# Email shop (destinatario interno su Vercel) — tutti i form / avvisi ordini
SHOP_EMAIL=info@corpoceleste.eu
# Admin portal (magic link): es. andrea@corpoceleste.eu
# PORTAL_ADMIN_EMAIL=andrea@corpoceleste.eu

# Base URL del sito: usata nei link di recesso/condizioni della conferma d'ordine
SITE_URL=https://www.corpoceleste.eu

# GitHub — token con permesso Contents: Read and write sul repo
GITHUB_TOKEN=
GITHUB_REPO=ultrastruttura/corpoceleste
GITHUB_BRANCH=main

# Spedire.com / Alsendo — API REST (chiedi base URL + key al supporto Spedire)
# Finché non hai le docs ufficiali: SPEDIRE_API_BASE + path sotto sono placeholder.
SPEDIRE_API_BASE=
SPEDIRE_API_KEY=
# Se usano Basic auth invece di Bearer, valorizza anche il secret:
# SPEDIRE_API_SECRET=
# Path (override quando arrivano le docs; default nel codice: /v1/rates e /v1/shipments)
# SPEDIRE_QUOTE_PATH=/v1/rates
# SPEDIRE_CREATE_PATH=/v1/shipments
SPEDIRE_FROM_COUNTRY=IT
SPEDIRE_FROM_ZIP=
SPEDIRE_FROM_CITY=
SPEDIRE_FROM_ADDRESS=
SPEDIRE_FROM_NAME=Andrea Baldelli
SPEDIRE_FROM_PHONE=
SPEDIRE_FROM_EMAIL=info@corpoceleste.eu
# Se PayPal non passa il telefono del buyer, fallback per creare l'etichetta
# SPEDIRE_DEFAULT_TO_PHONE=
# Pacco default maglie (cm / kg a pezzo) — opzionale
# SPEDIRE_PKG_WIDTH=35
# SPEDIRE_PKG_HEIGHT=25
# SPEDIRE_PKG_LENGTH=8
# SPEDIRE_PKG_WEIGHT=0.4
