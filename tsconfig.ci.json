{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "api/**/*.ts",
    "src/lib/paypal-lines.ts",
    "src/lib/ship-normalize.ts",
    "src/lib/ship-countries.ts",
    "src/lib/pickup.ts",
    "src/lib/product-status.ts",
    "src/scripts/checkout-ship.ts",
    "tests/unit/**/*.ts"
  ]
}
