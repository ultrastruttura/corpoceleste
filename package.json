{
  "name": "corpoceleste",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --disable-warning=DEP0190 ./node_modules/@tinacms/cli/bin/tinacms dev -c \"astro dev\"",
    "build": "tinacms build --local --skip-cloud-checks && astro build",
    "build:cloud": "tinacms build && astro build",
    "build:site": "astro build",
    "optimize:prints": "node scripts/optimize-prints.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@libsql/client": "^0.18.0",
    "@vercel/node": "^16.0.2",
    "astro": "^7.3.5",
    "gray-matter": "^4.0.3",
    "tinacms": "^3.15.0"
  },
  "devDependencies": {
    "@tinacms/cli": "^4.0.4"
  }
}
